#cloud-config
# Discovery agent VM (opt-in) — runs netboxlabs/orb-agent to scan the Multipass /24 via
# network_discovery (nmap) and ingest discovered IPs/hosts into Diode over gRPC. The NetBox server
# IP + subnet are injected at render time from multipass_instance.server.ipv4 (same edge as the
# client). orb-agent runs as a long-running systemd service (--net=host); it runs its policy on load
# and then on the policy schedule, so `just netbox-discover` (restart the service) triggers an
# on-demand scan. See specs/netbox-discovery.md.
package_update: true
package_upgrade: true

${ntp_timesync}

packages:
  - docker.io
  - curl
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # orb-agent policy (network_discovery over the /24), rendered by OpenTofu.
  - path: /opt/orb/agent.yaml
    permissions: '0644'
    content: |
      ${indent(6, orb_config)}
%{ if enable_netdata ~}

  # Netdata agent (shared snippet) — installed by a runcmd below; serves the Prometheus endpoint
  # on :19999 (/api/v1/allmetrics?format=prometheus). See specs/shared-netdata.md.
  - path: /usr/local/sbin/install-netdata.sh
    permissions: '0755'
    content: |
      ${indent(6, netdata_installer)}
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if ntp_server != "" ~}

  # Internal NTP source — point systemd-timesyncd at the lab NTP server (shared snippet). See specs/shared-ntp.md.
  - path: /etc/systemd/timesyncd.conf.d/99-centralized-ntp.conf
    permissions: '0644'
    content: |
      ${indent(6, ntp_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}

  # Long-running orb-agent runner. Waits for the Diode ingress to accept connections, then runs the
  # agent (which executes its policy on load + on schedule). Writes a readiness marker once the
  # container is up (asserted by testinfra).
  - path: /usr/local/sbin/orb-agent-run.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -uo pipefail
      NETBOX_IP="${netbox_ip}"
      DIODE_PORT="${diode_port}"

      # Wait for the Diode ingress port to be reachable (the server brings Diode up asynchronously).
      for _ in $(seq 1 180); do
        if timeout 2 bash -c "cat < /dev/null > /dev/tcp/$NETBOX_IP/$DIODE_PORT" 2>/dev/null; then break; fi
        sleep 5
      done

      mkdir -p /var/lib/orb-agent
      touch /var/lib/orb-agent/discovery-done

      # Foreground run (systemd Type=simple keeps it alive; Restart=always covers transient failures).
      exec docker run --rm --net=host \
        -v /opt/orb:/opt/orb \
        -e DIODE_CLIENT_ID=diode-ingest \
        -e DIODE_CLIENT_SECRET='${diode_ingest_client_secret}' \
        ${orb_agent_image} run -c /opt/orb/agent.yaml

  - path: /etc/systemd/system/orb-agent.service
    permissions: '0644'
    content: |
      [Unit]
      Description=orb-agent network discovery -> Diode
      After=network-online.target docker.service
      Wants=network-online.target
      Requires=docker.service
      [Service]
      Type=simple
      ExecStartPre=-/usr/bin/docker pull ${orb_agent_image}
      ExecStart=/usr/local/sbin/orb-agent-run.sh
      Restart=always
      RestartSec=15
      [Install]
      WantedBy=multi-user.target

runcmd:
  # Enforce UTC late (Multipass injects the host timezone at first boot — see specs/ntp.md).
  - timedatectl set-timezone Etc/UTC
%{ if ntp_server != "" ~}
  # Internal NTP source — apply the timesyncd drop-in written above. See specs/shared-ntp.md.
  - systemctl restart systemd-timesyncd
%{ endif ~}
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  - systemctl enable --now docker
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ if enable_netdata ~}
  # Netdata agent — install + tune for max stats (best-effort; idempotent re-run:
  # `sudo /usr/local/sbin/install-netdata.sh`). Serves :19999. See specs/shared-netdata.md.
  - /usr/local/sbin/install-netdata.sh || true
%{ endif ~}
  - systemctl daemon-reload
  # Start asynchronously so cloud-init completes inside Multipass's 300s launch window (the runner
  # waits up to ~15 min for the server's Diode to come up).
  - systemctl enable orb-agent.service
  - systemctl start --no-block orb-agent.service
