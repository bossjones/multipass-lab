# Diode server .env — rendered from sample.env with PINNED LAB secrets (we do NOT run quickstart.sh,
# which randomizes them at runtime and would break this repo's render-time secret model). All values
# here are LAB-ONLY and deliberately non-secret; do NOT copy to Proxmox. See specs/netbox-discovery.md.
#
# __SERVER_IP__ is replaced with the server VM's runtime IP by netbox-stack.sh before `docker compose
# up` (Diode and NetBox are separate compose projects, so they reach each other over the host IP).

PROJECT_NAME=diode
DIODE_TAG=${diode_tag}

# nginx ingress — the only externally published port (gRPC + HTTP multiplexed).
DIODE_NGINX_PORT=${diode_port}

# Redis (internal) — Diode's ingest stream backend.
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_PASSWORD=${redis_password}

# Postgres (internal) — backs both the `diode` and `hydra` databases.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=diode
POSTGRES_USER=diode
POSTGRES_PASSWORD=${postgres_password}

# Ory Hydra (internal OAuth2 server).
HYDRA_SECRETS_SYSTEM_0=${hydra_system_secret}
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_TTL_ACCESS_TOKEN=1h

# Auth issue/introspect.
DIODE_AUTH_TOKEN_URL=http://diode-auth:8080/token

# Reconciler -> NetBox (via the diode-netbox-plugin API). __SERVER_IP__ is substituted at runtime.
NETBOX_DIODE_PLUGIN_API_BASE_URL=http://__SERVER_IP__:${netbox_port}/api/plugins/diode
NETBOX_DIODE_PLUGIN_SKIP_TLS_VERIFY=true
DIODE_TO_NETBOX_CLIENT_ID=diode-to-netbox
DIODE_TO_NETBOX_CLIENT_SECRET=${diode_to_netbox_client_secret}
DIODE_TO_NETBOX_RATE_LIMITER_RPS=20
DIODE_TO_NETBOX_RATE_LIMITER_BURST=1

# Reconciler behaviour.
MIGRATION_ENABLED=true
AUTO_APPLY_PROCESSOR_BATCH_SIZE=50
LOGGING_LEVEL=INFO

# Telemetry — Prometheus /metrics on each service's TELEMETRY_METRICS_PORT (published in the compose).
TELEMETRY_METRICS_EXPORTER=prometheus
TELEMETRY_METRICS_PORT=${diode_metrics_port}
