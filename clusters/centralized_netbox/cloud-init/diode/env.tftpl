# Diode server .env — reconciled to the ACTUAL netboxlabs/diode release sample.env
# (diode-server/docker/sample.env, `release` branch), rendered with PINNED LAB secrets. We do NOT
# run quickstart.sh (it randomizes the secrets at runtime, which breaks this repo's render-time
# secret model). Every value here is LAB-ONLY and deliberately non-secret; do NOT copy to Proxmox.
# See specs/netbox-discovery.md.
#
# __SERVER_IP__ is replaced with the server VM's runtime IP by netbox-stack.sh before `docker compose
# up` (Diode and NetBox are separate compose projects, so the reconciler reaches NetBox's
# /api/plugins/diode over the host IP).

# Pin the diode-* image tag (upstream leaves this unset -> `latest`). 2.0.0 is arm64-native for
# ingester/reconciler/auth. PROJECT_NAME keeps the compose project named `diode`.
PROJECT_NAME=diode
DIODE_TAG=${diode_tag}

# nginx ingress — the only externally published port (gRPC + HTTP multiplexed on :80 -> host).
DIODE_NGINX_PORT=${diode_port}

# Redis — Diode's ingest stream backend (note the non-default port 6378, matching upstream).
REDIS_PASSWORD=${redis_password}
REDIS_HOST=redis
REDIS_PORT=6378
REDIS_USERNAME=

LOGGING_LEVEL=INFO
SENTRY_DSN=
MIGRATION_ENABLED=true

# Postgres — a SINGLE instance hosts both the `diode` and `hydra` databases (created by the mounted
# initdb script; see docker-compose.yaml.tftpl + postgres-init.sh.tftpl). All three roles share the
# one pinned lab password.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=${postgres_password}
DIODE_POSTGRES_DB_NAME=diode
DIODE_POSTGRES_USER=diode
DIODE_POSTGRES_PASSWORD=${postgres_password}

# Telemetry — prometheus exporter is enabled on each diode service (no metrics port is published to
# the host; the real release scrapes internally). Traces disabled.
TELEMETRY_ENVIRONMENT=dev
TELEMETRY_METRICS_EXPORTER=prometheus
TELEMETRY_TRACES_EXPORTER=none

# Ory Hydra (internal OAuth2 server) — shares the postgres instance via its own `hydra` DB.
HYDRA_POSTGRES_DB_NAME=hydra
HYDRA_POSTGRES_USER=hydra
HYDRA_POSTGRES_PASSWORD=${postgres_password}
HYDRA_STRATEGIES_ACCESS_TOKEN=jwt
HYDRA_STRATEGIES_REFRESH_TOKEN=jwt
HYDRA_STRATEGIES_JWT_SCOPE_CLAIM=both
HYDRA_TTL_ACCESS_TOKEN=1h
HYDRA_OIDC_SUBJECT_IDENTIFIERS_SUPPORTED_TYPES=public
HYDRA_URLS_SELF_ISSUER=http://127.0.0.1:4444
HYDRA_SECRETS_SYSTEM_0=${hydra_system_secret}

# diode-auth (token issue/introspect) + the Hydra OAuth2 endpoints it fronts.
AUTH_HTTP_PORT=8080
OAUTH2_PUBLIC_SERVER_URL=http://hydra:4444
OAUTH2_ADMIN_SERVER_URL=http://hydra:4445
DIODE_AUTH_TOKEN_URL=http://diode-auth:8080/token

# Reconciler -> NetBox (via the diode-netbox-plugin API). __SERVER_IP__ is substituted at runtime.
# The pinned `diode-to-netbox` OAuth2 client authenticates the reconciler to the plugin.
DIODE_TO_NETBOX_CLIENT_ID=diode-to-netbox
DIODE_TO_NETBOX_CLIENT_SECRET=${diode_to_netbox_client_secret}
DIODE_TO_NETBOX_RATE_LIMITER_RPS=20
DIODE_TO_NETBOX_RATE_LIMITER_BURST=1
NETBOX_DIODE_PLUGIN_API_BASE_URL=http://__SERVER_IP__:${netbox_port}/api/plugins/diode
NETBOX_DIODE_PLUGIN_API_TIMEOUT_SECONDS=30
NETBOX_DIODE_PLUGIN_SKIP_TLS_VERIFY=true

# Graph DB feature (optional - disabled by default).
ENABLE_GRAPH_DB=false

# Ingest/apply processor tuning (upstream defaults).
INGESTION_LOG_PROCESSOR_BATCH_SIZE=50
INGESTION_LOG_PROCESSOR_CONCURRENCY=1
AUTO_APPLY_PROCESSOR_BATCH_SIZE=50
AUTO_APPLY_PROCESSOR_CONCURRENCY=1
