#cloud-config
# Self-registering test VM — on first boot it POSTs itself into NetBox as a Virtual Machine
# (name + eth0 interface + primary IPv4) via the REST API. The NetBox server IP is injected at
# render time from multipass_instance.server.ipv4. See specs/centralized_netbox.md.
package_update: true
package_upgrade: true

timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
%{ if dns_server != "" ~}
  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
  # Idempotent self-registration: every object is upserted (GET-by-name, POST if absent), so a
  # re-run PATCHes rather than duplicating. Writes a marker on success (asserted by testinfra).
  - path: /usr/local/sbin/netbox-register.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -uo pipefail
      NETBOX_URL="http://${netbox_ip}:${netbox_port}"
      TOKEN="${netbox_api_token}"
      CLUSTER_NAME="${cluster_name}"
      HOST_DEVICE="${host_device_name}"
      auth=(-H "Authorization: Token $TOKEN" -H "Content-Type: application/json" -H "Accept: application/json")

      register() {
        set -e

        # 1. Wait for NetBox to be reachable AND our token to be live (authed status = 200). The
        # server provisions the pinned token during its own bootstrap, so this also waits for that.
        for _ in $(seq 1 180); do
          if curl -sf "$${auth[@]}" "$NETBOX_URL/api/status/" >/dev/null 2>&1; then break; fi
          sleep 5
        done

        # 2. This VM's identity: hostname + primary IPv4.
        VM_NAME="$(hostname)"
        IP="$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')"

        # 3. Resolve the cluster the server bootstrapped (retry if it is not ready yet).
        CLUSTER_ID="$(curl -sf "$${auth[@]}" "$NETBOX_URL/api/virtualization/clusters/?name=$CLUSTER_NAME" | jq -r '.results[0].id // empty')"
        if [ -z "$CLUSTER_ID" ]; then
          echo "cluster $CLUSTER_NAME not found in NetBox yet" >&2
          return 1
        fi

        # 3b. Resolve the seeded host Device to link this VM to it ("runs on"). Gate on it the same
        # way we gate on the cluster: if the server's seed hasn't created it yet, return and let the
        # retry loop wait it out, so the device link is deterministic rather than racing the seed.
        HOST_ID="$(curl -sf "$${auth[@]}" "$NETBOX_URL/api/dcim/devices/?name=$HOST_DEVICE" | jq -r '.results[0].id // empty')"
        if [ -z "$HOST_ID" ]; then
          echo "host device $HOST_DEVICE not in NetBox yet" >&2
          return 1
        fi

        # 4. Upsert the virtual-machine, linked to the host device.
        VM_ID="$(curl -sf "$${auth[@]}" "$NETBOX_URL/api/virtualization/virtual-machines/?name=$VM_NAME" | jq -r '.results[0].id // empty')"
        if [ -z "$VM_ID" ]; then
          VM_ID="$(curl -sf "$${auth[@]}" -X POST "$NETBOX_URL/api/virtualization/virtual-machines/" \
            -d "{\"name\":\"$VM_NAME\",\"cluster\":$CLUSTER_ID,\"status\":\"active\",\"device\":$HOST_ID}" | jq -r '.id')"
        else
          curl -sf "$${auth[@]}" -X PATCH "$NETBOX_URL/api/virtualization/virtual-machines/$VM_ID/" \
            -d "{\"device\":$HOST_ID}" >/dev/null
        fi

        # 5. Upsert the eth0 interface.
        IF_ID="$(curl -sf "$${auth[@]}" "$NETBOX_URL/api/virtualization/interfaces/?virtual_machine_id=$VM_ID&name=eth0" | jq -r '.results[0].id // empty')"
        if [ -z "$IF_ID" ]; then
          IF_ID="$(curl -sf "$${auth[@]}" -X POST "$NETBOX_URL/api/virtualization/interfaces/" \
            -d "{\"virtual_machine\":$VM_ID,\"name\":\"eth0\"}" | jq -r '.id')"
        fi

        # 6. Upsert the IP address bound to eth0, then set it as the VM's primary_ip4.
        ADDR="$IP/24"
        IPADDR_ID="$(curl -sf "$${auth[@]}" "$NETBOX_URL/api/ipam/ip-addresses/?address=$ADDR" | jq -r '.results[0].id // empty')"
        if [ -z "$IPADDR_ID" ]; then
          IPADDR_ID="$(curl -sf "$${auth[@]}" -X POST "$NETBOX_URL/api/ipam/ip-addresses/" \
            -d "{\"address\":\"$ADDR\",\"assigned_object_type\":\"virtualization.vminterface\",\"assigned_object_id\":$IF_ID,\"status\":\"active\"}" | jq -r '.id')"
        fi
        curl -sf "$${auth[@]}" -X PATCH "$NETBOX_URL/api/virtualization/virtual-machines/$VM_ID/" \
          -d "{\"primary_ip4\":$IPADDR_ID}" >/dev/null

        mkdir -p /var/lib/netbox-register
        touch /var/lib/netbox-register/done
      }

      # Retry the whole (idempotent) registration — waits out the server's own bring-up.
      for attempt in $(seq 1 12); do
        if register; then
          echo "netbox registration complete (attempt $attempt)"
          exit 0
        fi
        echo "registration attempt $attempt failed; retrying in 20s" >&2
        sleep 20
      done
      echo "registration failed after retries" >&2
      exit 1

  - path: /etc/systemd/system/netbox-register.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Self-register this VM into NetBox
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/netbox-register.sh
      RemainAfterExit=yes
      TimeoutStartSec=0
      [Install]
      WantedBy=multi-user.target

  # Generic exporter installer: download a GitHub release (tar.gz or raw binary), drop the
  # binary in /usr/local/bin, install + enable a systemd unit. {ARCH} in the URL is replaced
  # with the host's Debian arch (arm64/amd64). Mirrors the other clusters' install pattern.
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"
%{ if enable_process_exporter ~}
  # process-exporter config: a small curated set + a bounded {{.Comm}} catch-all (empty groups
  # pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}

runcmd:
  # Enforce UTC late (Multipass injects the host timezone at first boot — see specs/ntp.md).
  - timedatectl set-timezone Etc/UTC
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
%{ endif ~}
  - systemctl daemon-reload
  # Start asynchronously: the register script waits (up to ~15 min) for the NetBox server to come
  # up, which would otherwise block cloud-init past Multipass's 300s launch window.
  - systemctl enable netbox-register.service
  - systemctl start --no-block netbox-register.service
%{ if enable_node_exporter ~}
  # node_exporter — OS host + systemd-unit metrics (:9100)
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.systemd
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|node_exporter|systemd_exporter|process-exporter|netbox-register)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}
%{ if enable_netdata ~}
  # netdata — real-time agent (:19999, /api/v1/allmetrics?format=prometheus).
  # Standalone/local-only: no --claim-token (no Netdata Cloud), telemetry disabled, updates pinned.
  - mkdir -p /etc/netdata && touch /etc/netdata/.opt-out-from-anonymous-statistics
  - curl -sSLf https://get.netdata.cloud/kickstart.sh -o /tmp/netdata-kickstart.sh && DO_NOT_TRACK=1 sh /tmp/netdata-kickstart.sh --non-interactive --stable-channel --disable-telemetry --no-updates --dont-wait || true
  # scripts.d must exist or netdata's external-plugins scanner logs a repeating warning
  - mkdir -p /etc/netdata/scripts.d && chown -R netdata:netdata /etc/netdata/scripts.d && systemctl restart netdata || true
%{ endif ~}
