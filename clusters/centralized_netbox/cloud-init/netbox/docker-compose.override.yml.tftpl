# netbox-docker override — copied next to the cloned compose file on the server VM.
# Publishes NetBox on the host and skips netbox-docker's own superuser creation: the bootstrap
# (netbox-stack.sh) creates the admin user + the pinned v1 API token via manage.py, so the setup
# is deterministic and independent of the image's env-var behaviour.
#
# When enable_discovery is on, netbox/netbox-worker/netbox-housekeeping run the locally-built
# `netbox:latest-plugins` image (netbox-stack.sh builds it with the legacy builder before `up`;
# pull_policy: never so compose reuses it instead of pulling/rebuilding). See specs/netbox-discovery.md.
services:
  netbox:
    ports:
      - "${netbox_port}:8080"
    environment:
      SKIP_SUPERUSER: "true"
      ALLOWED_HOSTS: "*"
%{ if enable_discovery ~}
    image: netbox:latest-plugins
    pull_policy: never
  netbox-worker:
    image: netbox:latest-plugins
    pull_policy: never
  netbox-housekeeping:
    image: netbox:latest-plugins
    pull_policy: never
%{ endif ~}
