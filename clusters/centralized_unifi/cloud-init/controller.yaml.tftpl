#cloud-config
# UniFi Controller (UCK Gen2) stand-in — the syslog-ng collector.
#
# version_mode = exact  : run the appliance's ACTUAL syslog-ng 3.28.1 (Debian bullseye) in a
#                         container (native arm64) + brandond/syslog_ng_exporter (legacy CSV stats,
#                         the exporter that works on 3.28.1 — i.e. the real UCK's path).
# version_mode = modern : install Ubuntu-stock syslog-ng 4.x on the bare VM + the native
#                         `syslog-ng-ctl stats prometheus` textfile exporter (prototyping only).
# See specs/centralized_unifi.md.
package_update: true
package_upgrade: true

# Time sync — pin every VM to UTC so log/metric timestamps align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - tar
  - jq
%{ if exact ~}
  - docker.io
  - docker-compose-v2
  # Safety net: brandond/syslog_ng_exporter may be an amd64-only image; binfmt lets Docker run it
  # emulated on the arm64 controller if no native variant exists (the syslog-ng image is native).
  - qemu-user-static
  - binfmt-support
%{ else ~}
  - syslog-ng
%{ endif ~}

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # Generic exporter installer (copied from the centralized_logging/centralized_monitoring clusters):
  # download a GitHub release, drop the binary in /usr/local/bin, install + enable a systemd unit.
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"

%{ if exact ~}
  # --- exact mode: the syslog-ng 3.28.1 container + exporter sidecar --------
  - path: /opt/unifi/Dockerfile
    permissions: '0644'
    content: |
      ${indent(6, controller_dockerfile)}

  - path: /opt/unifi/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, controller_compose)}

  - path: /opt/unifi/uck.conf
    permissions: '0644'
    content: |
      ${indent(6, uck_conf)}
%{ else ~}
  # --- modern mode: bare syslog-ng 4.x config + native textfile exporter ----
  - path: /etc/syslog-ng/syslog-ng.conf
    permissions: '0644'
    content: |
      ${indent(6, uck_conf)}

  - path: /usr/local/sbin/syslogng-textfile.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      out=/var/lib/node_exporter/textfile_collector/syslogng.prom
      tmp="$(mktemp)"
      /usr/sbin/syslog-ng-ctl stats prometheus > "$tmp" 2>/dev/null || true
      mv "$tmp" "$out"
  - path: /etc/systemd/system/syslogng-textfile.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Write syslog-ng prometheus stats to the node_exporter textfile collector
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/syslogng-textfile.sh
  - path: /etc/systemd/system/syslogng-textfile.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh syslog-ng textfile metrics every 15s
      [Timer]
      OnBootSec=30
      OnUnitActiveSec=15
      [Install]
      WantedBy=timers.target
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative timezone: key above. runcmd runs after the config modules, so it wins.
  - timedatectl set-timezone Etc/UTC
  - mkdir -p /var/log/remote
%{ if exact ~}
  - mkdir -p /etc/docker
  - systemctl enable docker
  - systemctl restart docker
  # Build + start the exact-version syslog-ng container (+ exporter). First build pulls the base
  # image; native arm64 for bullseye, so no emulation for the collector itself.
  - docker compose -f /opt/unifi/compose.yaml up -d --build
%{ else ~}
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}
%{ if enable_node_exporter ~}
  - mkdir -p /var/lib/node_exporter/textfile_collector
  # node_exporter — OS host metrics (:9100). In modern mode it also serves the syslog-ng .prom.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if !exact && enable_node_exporter ~}
  - systemctl enable --now syslogng-textfile.timer
%{ endif ~}

final_message: "unifi controller ready — syslog-ng collector on :${syslog_port}; logs under /var/log/remote; metrics on :9100${enable_syslogng_exporter ? " + :9577 (syslog-ng stats)" : ""}"
