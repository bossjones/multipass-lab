#cloud-config
# UniFi Controller (UCK Gen2) stand-in — the syslog-ng collector.
#
# version_mode = exact  : run the appliance's ACTUAL syslog-ng 3.28.1 (Debian bullseye) in a
#                         container (native arm64) + brandond/syslog_ng_exporter (legacy CSV stats,
#                         the exporter that works on 3.28.1 — i.e. the real UCK's path).
# version_mode = modern : install Ubuntu-stock syslog-ng 4.x on the bare VM + the native
#                         `syslog-ng-ctl stats prometheus` textfile exporter (prototyping only).
# See specs/centralized_unifi.md.
package_update: true
package_upgrade: true

${ntp_timesync}

packages:
  - curl
  - tar
  - jq
%{ if exact ~}
  - docker.io
  - docker-compose-v2
  # Safety net: brandond/syslog_ng_exporter may be an amd64-only image; binfmt lets Docker run it
  # emulated on the arm64 controller if no native variant exists (the syslog-ng image is native).
  - qemu-user-static
  - binfmt-support
%{ else ~}
  - syslog-ng
%{ endif ~}

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # Generic exporter installer (copied from the centralized_logging/centralized_monitoring clusters):
  # download a GitHub release, drop the binary in /usr/local/bin, install + enable a systemd unit.
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"
%{ if enable_netdata ~}

  # Netdata agent (shared snippet) — installed by a runcmd below; serves the Prometheus endpoint
  # on :19999 (/api/v1/allmetrics?format=prometheus). See specs/shared-netdata.md.
  - path: /usr/local/sbin/install-netdata.sh
    permissions: '0755'
    content: |
      ${indent(6, netdata_installer)}
%{ endif ~}

%{ if exact ~}
  # --- exact mode: the syslog-ng 3.28.1 container + exporter sidecar --------
  - path: /opt/unifi/Dockerfile
    permissions: '0644'
    content: |
      ${indent(6, controller_dockerfile)}

  - path: /opt/unifi/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, controller_compose)}

  - path: /opt/unifi/uck.conf
    permissions: '0644'
    content: |
      ${indent(6, uck_conf)}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}
%{ else ~}
  # --- modern mode: bare syslog-ng 4.x config + native textfile exporter ----
  - path: /etc/syslog-ng/syslog-ng.conf
    permissions: '0644'
    content: |
      ${indent(6, uck_conf)}

  - path: /usr/local/sbin/syslogng-textfile.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      out=/var/lib/node_exporter/textfile_collector/syslogng.prom
      tmp="$(mktemp)"
      /usr/sbin/syslog-ng-ctl stats prometheus > "$tmp" 2>/dev/null || true
      mv "$tmp" "$out"
  - path: /etc/systemd/system/syslogng-textfile.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Write syslog-ng prometheus stats to the node_exporter textfile collector
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/syslogng-textfile.sh
  - path: /etc/systemd/system/syslogng-textfile.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh syslog-ng textfile metrics every 15s
      [Timer]
      OnBootSec=30
      OnUnitActiveSec=15
      [Install]
      WantedBy=timers.target
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if ntp_server != "" ~}

  # Internal NTP source — point systemd-timesyncd at the lab NTP server (shared snippet). See specs/shared-ntp.md.
  - path: /etc/systemd/timesyncd.conf.d/99-centralized-ntp.conf
    permissions: '0644'
    content: |
      ${indent(6, ntp_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative timezone: key above. runcmd runs after the config modules, so it wins.
  - timedatectl set-timezone Etc/UTC
%{ if ntp_server != "" ~}
  # Internal NTP source — apply the timesyncd drop-in written above. See specs/shared-ntp.md.
  - systemctl restart systemd-timesyncd
%{ endif ~}
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
  # Wait until the new resolver actually answers before the docker image build/pull below runs —
  # otherwise a boot-time race with the AdGuard hub warming up makes the `docker compose up --build`
  # pull hang ("Could not resolve host"), stalling the apply with no failed unit. Mirrors the gate in
  # centralized_logging/docker-client.yaml.tftpl.
  - |
    for i in $(seq 1 30); do
      getent hosts registry-1.docker.io >/dev/null 2>&1 && break
      sleep 2
    done
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  - mkdir -p /var/log/remote
%{ if exact ~}
  - mkdir -p /etc/docker
  - systemctl enable docker
  - systemctl restart docker
  # Build + start the exact-version syslog-ng container (+ exporter). First build pulls the base
  # image; native arm64 for bullseye, so no emulation for the collector itself.
  # Retry so a transient DNS/registry SERVFAIL on a base-image pull can't abort the build.
  - |
    for i in $(seq 1 5); do
      docker compose -f /opt/unifi/compose.yaml up -d --build && break
      echo "controller compose up attempt $i failed; retrying"; sleep 10
    done
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ else ~}
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}
%{ if enable_netdata ~}
  # Netdata agent — install + tune for max stats (best-effort; idempotent re-run:
  # `sudo /usr/local/sbin/install-netdata.sh`). Serves :19999. See specs/shared-netdata.md.
  - /usr/local/sbin/install-netdata.sh || true
%{ endif ~}
%{ if enable_node_exporter ~}
  - mkdir -p /var/lib/node_exporter/textfile_collector
  # node_exporter — OS host metrics (:9100). In modern mode it also serves the syslog-ng .prom.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if !exact && enable_node_exporter ~}
  - systemctl enable --now syslogng-textfile.timer
%{ endif ~}

final_message: "unifi controller ready — syslog-ng collector on :${syslog_port}; logs under /var/log/remote; metrics on :9100${enable_syslogng_exporter ? " + :9577 (syslog-ng stats)" : ""}"
