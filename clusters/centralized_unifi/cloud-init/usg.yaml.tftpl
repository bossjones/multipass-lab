#cloud-config
# UniFi Security Gateway (USG / `ubnt`) stand-in — the rsyslog forwarder.
#
# version_mode = exact  : run the appliance's ACTUAL rsyslog 5.8.11 (Debian wheezy) in a container.
#                         wheezy has no arm64 build, so on Apple Silicon it runs emulated as amd64
#                         (qemu-user-static/binfmt on the VM host). The traffic generator runs inside
#                         the container so `logger` shares /dev/log with rsyslog.
# version_mode = modern : install Ubuntu-stock rsyslog 8.x on the bare VM + the Vyatta forward rule;
#                         the generator runs as a host systemd timer.
# See specs/centralized_unifi.md.
package_update: true
package_upgrade: true

${ntp_timesync}

packages:
  - curl
  - tar
  - jq
%{ if exact ~}
  - docker.io
  - docker-compose-v2
  # wheezy is amd64-only; qemu-user-static + binfmt let Docker build/run the amd64 image on arm64.
  - qemu-user-static
  - binfmt-support
%{ else ~}
  - rsyslog
%{ endif ~}

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"

%{ if exact ~}
  # --- exact mode: the rsyslog 5.8.11 (wheezy, emulated amd64) container ----
  - path: /opt/unifi/Dockerfile
    permissions: '0644'
    content: |
      ${indent(6, usg_dockerfile)}

  - path: /opt/unifi/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, usg_compose)}

  - path: /opt/unifi/rsyslog.conf
    permissions: '0644'
    content: |
      ${indent(6, rsyslog_conf)}

  - path: /opt/unifi/vyatta-log.conf
    permissions: '0644'
    content: |
      ${indent(6, vyatta_conf)}

  - path: /opt/unifi/unifi-gen.sh
    permissions: '0755'
    content: |
      ${indent(6, gen_script)}

  - path: /opt/unifi/usg-entrypoint.sh
    permissions: '0755'
    content: |
      ${indent(6, entrypoint_script)}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}
%{ else ~}
  # --- modern mode: bare rsyslog 8.x + the Vyatta forward + a host generator timer ----
  - path: /etc/rsyslog.d/vyatta-log.conf
    permissions: '0644'
    content: |
      ${indent(6, vyatta_conf)}

  - path: /usr/local/sbin/unifi-gen.sh
    permissions: '0755'
    content: |
      ${indent(6, gen_script)}

  - path: /etc/systemd/system/unifi-gen.service
    permissions: '0644'
    content: |
      [Unit]
      Description=UniFi USG traffic generator
      After=rsyslog.service
      [Service]
      ExecStart=/usr/local/sbin/unifi-gen.sh
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if ntp_server != "" ~}

  # Internal NTP source — point systemd-timesyncd at the lab NTP server (shared snippet). See specs/shared-ntp.md.
  - path: /etc/systemd/timesyncd.conf.d/99-centralized-ntp.conf
    permissions: '0644'
    content: |
      ${indent(6, ntp_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}

runcmd:
  - timedatectl set-timezone Etc/UTC
%{ if ntp_server != "" ~}
  # Internal NTP source — apply the timesyncd drop-in written above. See specs/shared-ntp.md.
  - systemctl restart systemd-timesyncd
%{ endif ~}
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
  # Wait until the new resolver actually answers before the docker pull / archive.debian.org curl /
  # image build below run — otherwise a boot-time race with the AdGuard hub warming up makes them
  # hang ("Could not resolve host"), stalling the apply with no failed unit. One getent probe proves
  # the resolver answers any external name. Mirrors centralized_logging/docker-client.yaml.tftpl.
  - |
    for i in $(seq 1 30); do
      getent hosts registry-1.docker.io >/dev/null 2>&1 && break
      sleep 2
    done
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
%{ if exact ~}
  - mkdir -p /etc/docker /opt/unifi
  - systemctl enable docker
  - systemctl restart docker
  # Register amd64 binfmt (qemu-user-static usually does this; belt-and-braces for Docker builds).
  - docker run --privileged --rm tonistiigi/binfmt --install amd64 || true
  # Fetch the EXACT wheezy rsyslog .deb natively on this arm64 host (curl, no emulation) and extract
  # it — wheezy's apt `http` method segfaults under qemu, so we never run apt inside the container.
  # The Dockerfile then overlays this tree onto the wheezy base. See specs/centralized_unifi.md.
  - curl -fsSL "http://archive.debian.org/debian/pool/main/r/rsyslog/rsyslog_${rsyslog_deb_version}_amd64.deb" -o /opt/unifi/rsyslog.deb
  - mkdir -p /opt/unifi/rsyslog-root/etc/rsyslog.d
  - dpkg-deb -x /opt/unifi/rsyslog.deb /opt/unifi/rsyslog-root
  # Build + start the exact-version rsyslog container (emulated amd64 — first build is slow).
  - docker compose -f /opt/unifi/compose.yaml up -d --build
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ else ~}
  - systemctl enable rsyslog
  - systemctl restart rsyslog
%{ if enable_unifi_traffic ~}
  - systemctl daemon-reload
  - systemctl enable --now unifi-gen.service
%{ endif ~}
%{ endif ~}
%{ if enable_node_exporter ~}
  # node_exporter — OS host metrics (:9100). Native arm64 on the VM host.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter
%{ endif ~}

final_message: "unifi usg ready — rsyslog forwarding to the controller on :${syslog_port}; host metrics on :9100"
