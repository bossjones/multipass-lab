{
  "version": 5,
  "dashboardId": "dns-adguard-home",
  "title": "AdGuard Home",
  "description": "DNS filtering front-end on the centralized_dns VM (adguard-exporter :9618, Prometheus job centralized-dns-adguard). Populates once `just up-connected` wires the DNS exporters into this cluster's Prometheus / metrics stream. AdGuard _queries/_blocked_*/top_* are 24h-window gauges (plotted raw, not rated).",
  "role": "",
  "owner": "centralized_monitoring",
  "variables": { "list": [], "showDynamicFilters": false },
  "tabs": [
    {
      "tabId": "default",
      "name": "Default",
      "panels": [
        {
          "id": "panel_adguard_running",
          "type": "metric",
          "title": "AdGuard running",
          "description": "1 = AdGuard Home is up and answering, 0 = down.",
          "config": { "show_legends": false, "unit": null, "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "max(adguard_running)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_running", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 0, "y": 0, "w": 12, "h": 6, "i": 1 }
        },
        {
          "id": "panel_adguard_queries_24h",
          "type": "metric",
          "title": "Queries (24h)",
          "description": "Total DNS queries AdGuard processed in the last 24h.",
          "config": { "show_legends": false, "unit": null, "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(adguard_queries)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_queries", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 12, "y": 0, "w": 12, "h": 6, "i": 2 }
        },
        {
          "id": "panel_adguard_blocked_24h",
          "type": "metric",
          "title": "Blocked (24h)",
          "description": "Queries blocked by filter lists + safesearch + safebrowsing in the last 24h.",
          "config": { "show_legends": false, "unit": null, "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(adguard_blocked_filtered) + sum(adguard_blocked_safesearch) + sum(adguard_blocked_safebrowsing)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_blocked_filtered", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 24, "y": 0, "w": 12, "h": 6, "i": 3 }
        },
        {
          "id": "panel_adguard_block_pct",
          "type": "metric",
          "title": "Block %",
          "description": "Blocked queries as a percentage of total queries (24h window).",
          "config": { "show_legends": false, "unit": "percent", "decimals": 1 },
          "queryType": "promql",
          "queries": [
            {
              "query": "100 * (sum(adguard_blocked_filtered) + sum(adguard_blocked_safesearch) + sum(adguard_blocked_safebrowsing)) / clamp_min(sum(adguard_queries), 1)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_queries", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 36, "y": 0, "w": 12, "h": 6, "i": 4 }
        },
        {
          "id": "panel_adguard_queries_vs_blocked",
          "type": "line",
          "title": "Queries vs blocked (24h window)",
          "description": "AdGuard's rolling 24h query and block counts over time.",
          "config": { "show_legends": true, "unit": null, "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(adguard_queries)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_queries", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "queries", "layer_type": "scatter", "weight_fixed": 1 }
            },
            {
              "query": "sum(adguard_blocked_filtered) + sum(adguard_blocked_safesearch) + sum(adguard_blocked_safebrowsing)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_blocked_filtered", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "blocked", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 0, "y": 6, "w": 24, "h": 9, "i": 5 }
        },
        {
          "id": "panel_adguard_query_types",
          "type": "line",
          "title": "Query types",
          "description": "Query volume by DNS record type.",
          "config": { "show_legends": true, "unit": null, "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum by (type) (adguard_query_types)",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_query_types", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "{{type}}", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 24, "y": 6, "w": 24, "h": 9, "i": 6 }
        },
        {
          "id": "panel_adguard_top_queried",
          "type": "table",
          "title": "Top queried domains",
          "description": "Most-queried domains (24h window).",
          "config": { "show_legends": false },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT domain AS \"x_axis_1\", max(value) AS \"y_axis_1\" FROM \"adguard_top_queried_domains\" GROUP BY x_axis_1 ORDER BY y_axis_1 DESC LIMIT 10",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "adguard_top_queried_domains",
                "stream_type": "metrics",
                "x": [ { "label": "domain", "alias": "x_axis_1", "column": "domain", "aggregationFunction": null } ],
                "y": [ { "label": "queries", "alias": "y_axis_1", "column": "value", "aggregationFunction": "max" } ],
                "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 0, "y": 15, "w": 16, "h": 9, "i": 7 }
        },
        {
          "id": "panel_adguard_top_blocked",
          "type": "table",
          "title": "Top blocked domains",
          "description": "Most-blocked domains (24h window).",
          "config": { "show_legends": false },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT domain AS \"x_axis_1\", max(value) AS \"y_axis_1\" FROM \"adguard_top_blocked_domains\" GROUP BY x_axis_1 ORDER BY y_axis_1 DESC LIMIT 10",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "adguard_top_blocked_domains",
                "stream_type": "metrics",
                "x": [ { "label": "domain", "alias": "x_axis_1", "column": "domain", "aggregationFunction": null } ],
                "y": [ { "label": "blocked", "alias": "y_axis_1", "column": "value", "aggregationFunction": "max" } ],
                "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 16, "y": 15, "w": 16, "h": 9, "i": 8 }
        },
        {
          "id": "panel_adguard_top_clients",
          "type": "table",
          "title": "Top clients",
          "description": "Busiest DNS clients (24h window).",
          "config": { "show_legends": false },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT client AS \"x_axis_1\", max(value) AS \"y_axis_1\" FROM \"adguard_top_clients\" GROUP BY x_axis_1 ORDER BY y_axis_1 DESC LIMIT 10",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "adguard_top_clients",
                "stream_type": "metrics",
                "x": [ { "label": "client", "alias": "x_axis_1", "column": "client", "aggregationFunction": null } ],
                "y": [ { "label": "queries", "alias": "y_axis_1", "column": "value", "aggregationFunction": "max" } ],
                "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": { "promql_legend": "", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 32, "y": 15, "w": 16, "h": 9, "i": 9 }
        },
        {
          "id": "panel_adguard_processing_percentiles",
          "type": "line",
          "title": "Processing-time percentiles",
          "description": "p50/p95/p99 AdGuard query processing time from the millisecond histogram.",
          "config": { "show_legends": true, "unit": "microseconds", "decimals": 0 },
          "queryType": "promql",
          "queries": [
            {
              "query": "histogram_quantile(0.50, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket[5m]))) * 1000",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_avg_processing_time_milliseconds_bucket", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "p50", "layer_type": "scatter", "weight_fixed": 1 }
            },
            {
              "query": "histogram_quantile(0.95, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket[5m]))) * 1000",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_avg_processing_time_milliseconds_bucket", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "p95", "layer_type": "scatter", "weight_fixed": 1 }
            },
            {
              "query": "histogram_quantile(0.99, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket[5m]))) * 1000",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_avg_processing_time_milliseconds_bucket", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "p99", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 0, "y": 24, "w": 24, "h": 9, "i": 10 }
        },
        {
          "id": "panel_adguard_scrape_errors",
          "type": "line",
          "title": "Exporter scrape errors",
          "description": "Rate of adguard-exporter scrape errors — sustained non-zero means the exporter can't reach AdGuard's API.",
          "config": { "show_legends": true, "unit": null, "decimals": 2 },
          "queryType": "promql",
          "queries": [
            {
              "query": "rate(adguard_scrape_errors_total[5m])",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": { "stream": "adguard_scrape_errors_total", "stream_type": "metrics", "x": [], "y": [], "z": [], "breakdown": [], "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] } },
              "config": { "promql_legend": "errors/sec", "layer_type": "scatter", "weight_fixed": 1 }
            }
          ],
          "layout": { "x": 24, "y": 24, "w": 24, "h": 9, "i": 11 }
        }
      ]
    }
  ]
}
