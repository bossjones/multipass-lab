# Managed by OpenTofu (clusters/centralized_monitoring). Grafana datasource provisioning:
# Prometheus always; OpenObserve only when enable_openobserve. No click-ops on first boot.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    access: proxy
    url: http://prometheus:9090
    isDefault: true
    editable: true
%{ if enable_openobserve ~}
  # OpenObserve exposed via its Prometheus-compatible PromQL HTTP API, so it provisions
  # cleanly as a built-in datasource type (no unsigned Grafana plugin to install).
  - name: OpenObserve
    type: prometheus
    access: proxy
    url: http://openobserve:5080/api/default/prometheus
    basicAuth: true
    basicAuthUser: admin@example.com
    secureJsonData:
      basicAuthPassword: ${openobserve_password}
    editable: true
%{ endif ~}
