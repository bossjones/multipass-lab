{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["dns", "adguard"],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(adguard_running, instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(adguard_running, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "current": {},
        "options": []
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "AdGuard Home",
  "uid": "adguard-home",
  "version": 1,
  "panels": [
    {
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**AdGuard Home** — DNS filtering front-end on the `centralized_dns` VM (`adguard-exporter` `:9618`, Prometheus job `centralized-dns-adguard`). Panels populate only after `just up-connected` wires the DNS exporters into this cluster's Prometheus. AdGuard's `_queries` / `_blocked_*` / `top_*` series are 24h-window gauges — plotted raw, not rated."
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 3 },
      "id": 1,
      "title": "Running",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "max(adguard_running{instance=~\"$instance\"})", "instant": true, "legendFormat": "running", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 3 },
      "id": 2,
      "title": "Protection",
      "type": "stat",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OFF", "color": "red" }, "1": { "text": "ON", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "max(adguard_protection_enabled{instance=~\"$instance\"})", "instant": true, "legendFormat": "protection", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 3 },
      "id": 3,
      "title": "Queries (24h)",
      "type": "stat",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(adguard_queries{instance=~\"$instance\"})", "instant": true, "legendFormat": "queries", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 3 },
      "id": 4,
      "title": "Blocked (24h)",
      "type": "stat",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "sum(adguard_blocked_filtered{instance=~\"$instance\"}) + sum(adguard_blocked_safesearch{instance=~\"$instance\"}) + sum(adguard_blocked_safebrowsing{instance=~\"$instance\"})", "instant": true, "legendFormat": "blocked", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 3 },
      "id": 5,
      "title": "Block %",
      "type": "gauge",
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "100 * (sum(adguard_blocked_filtered{instance=~\"$instance\"}) + sum(adguard_blocked_safesearch{instance=~\"$instance\"}) + sum(adguard_blocked_safebrowsing{instance=~\"$instance\"})) / clamp_min(sum(adguard_queries{instance=~\"$instance\"}), 1)", "instant": true, "legendFormat": "block %", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 3 },
      "id": 6,
      "title": "Avg processing time",
      "type": "stat",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "avg(adguard_avg_processing_time_seconds{instance=~\"$instance\"})", "instant": true, "legendFormat": "avg", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 7,
      "title": "Queries vs blocked (24h window)",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        { "expr": "sum(adguard_queries{instance=~\"$instance\"})", "legendFormat": "queries", "refId": "A" },
        { "expr": "sum(adguard_blocked_filtered{instance=~\"$instance\"}) + sum(adguard_blocked_safesearch{instance=~\"$instance\"}) + sum(adguard_blocked_safebrowsing{instance=~\"$instance\"})", "legendFormat": "blocked", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 8,
      "title": "Blocked by reason (24h window)",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        { "expr": "sum(adguard_blocked_filtered{instance=~\"$instance\"})", "legendFormat": "filter lists", "refId": "A" },
        { "expr": "sum(adguard_blocked_safesearch{instance=~\"$instance\"})", "legendFormat": "safesearch", "refId": "B" },
        { "expr": "sum(adguard_blocked_safebrowsing{instance=~\"$instance\"})", "legendFormat": "safebrowsing", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 9,
      "title": "Query types",
      "type": "bargauge",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "expr": "sum by (type) (adguard_query_types{instance=~\"$instance\"})", "instant": true, "legendFormat": "{{type}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 10,
      "title": "Top queried domains",
      "type": "bargauge",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-BlPu" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "expr": "topk(10, sum by (domain) (adguard_top_queried_domains{instance=~\"$instance\"}))", "instant": true, "legendFormat": "{{domain}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 11,
      "title": "Top blocked domains",
      "type": "bargauge",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-RdYlGr" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "expr": "topk(10, sum by (domain) (adguard_top_blocked_domains{instance=~\"$instance\"}))", "instant": true, "legendFormat": "{{domain}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 12,
      "title": "Top clients",
      "type": "bargauge",
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "expr": "topk(10, sum by (client) (adguard_top_clients{instance=~\"$instance\"}))", "instant": true, "legendFormat": "{{client}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 13,
      "title": "Top upstreams — avg response time",
      "type": "bargauge",
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "continuous-YlRd" } }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "targets": [
        { "expr": "topk(10, sum by (upstream) (adguard_top_upstreams_avg_response_time_seconds{instance=~\"$instance\"}))", "instant": true, "legendFormat": "{{upstream}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 14,
      "title": "Processing-time percentiles",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(adguard_avg_processing_time_milliseconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 15,
      "title": "Scrape errors / DHCP leases",
      "type": "timeseries",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "rate(adguard_scrape_errors_total{instance=~\"$instance\"}[5m])", "legendFormat": "scrape errors/s", "refId": "A" },
        { "expr": "sum(adguard_dhcp_leases{instance=~\"$instance\"})", "legendFormat": "dhcp leases", "refId": "B" }
      ]
    }
  ]
}
