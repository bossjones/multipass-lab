#cloud-config
# Observability server — a single Docker Compose stack. The spine (Prometheus,
# Alertmanager, Grafana) is always on; every MVP/Reach/Nice server service whose
# enable_* flag is true is rendered into compose.yaml. Prometheus loads the rendered
# prometheus.yml (which carries the injected k0s client IP as a scrape target) plus
# alert.rules.yml. Grafana datasources + starter dashboards are provisioned from files
# dropped here, so there is no click-ops on first boot.
package_update: true
package_upgrade: true

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so log/metric timestamps align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - vim
  - htop
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # --- Prometheus (spine) ---------------------------------------------------
  - path: /opt/stack/prometheus/prometheus.yml
    permissions: '0644'
    content: |
      ${indent(6, prometheus_yml)}

  - path: /opt/stack/prometheus/alert.rules.yml
    permissions: '0644'
    content: |
      ${indent(6, alert_rules)}

  # --- Alertmanager (spine) -------------------------------------------------
  - path: /opt/stack/alertmanager/alertmanager.yml
    permissions: '0644'
    content: |
      ${indent(6, alertmanager_yml)}

  # --- Grafana provisioning (spine) -----------------------------------------
  - path: /opt/stack/grafana/provisioning/datasources/datasources.yaml
    permissions: '0644'
    content: |
      ${indent(6, grafana_datasources)}

  - path: /opt/stack/grafana/provisioning/dashboards/dashboards.yaml
    permissions: '0644'
    content: |
      ${indent(6, grafana_dash_prov)}

  # --- Grafana dashboards (drop-a-file; gz+b64 keeps large JSON compact) ------
  # One entry per *.json under cloud-init/grafana/dashboards; the relative path is
  # preserved so foldersFromFilesStructure files each into its subdir's Grafana folder.
%{ for d in grafana_dashboards ~}
  - path: /opt/stack/grafana/dashboards/${d.name}
    permissions: '0644'
    encoding: gz+b64
    content: ${base64gzip(d.content)}
%{ endfor ~}
%{ if enable_blackbox ~}
  # --- blackbox_exporter ----------------------------------------------------
  - path: /opt/stack/blackbox/blackbox.yml
    permissions: '0644'
    content: |
      ${indent(6, blackbox_yml)}
%{ endif ~}
%{ if enable_otel ~}
  # --- OpenTelemetry Collector ----------------------------------------------
  - path: /opt/stack/otel/collector-config.yaml
    permissions: '0644'
    content: |
      ${indent(6, otel_config)}
%{ endif ~}
%{ if enable_openobserve ~}
  # --- OpenObserve dashboards (drop-a-file; imported post-boot by the script below) ----
  # One entry per titled *.json under openobserve/dashboards; the relative path is preserved so
  # openobserve-provision.sh files each into its subdir's OpenObserve folder. gz+b64 keeps large
  # JSON compact in the user-data.
%{ for d in openobserve_dashboards ~}
  - path: /opt/stack/openobserve/dashboards/${d.name}
    permissions: '0644'
    encoding: gz+b64
    content: ${base64gzip(d.content)}
%{ endfor ~}
  # Seeds the otlp_logs logs+traces streams, then imports the dashboards above (idempotent).
  - path: /usr/local/sbin/openobserve-provision.sh
    permissions: '0755'
    content: |
      ${indent(6, openobserve_provision_sh)}
%{ endif ~}
%{ if enable_ssh_exporter ~}
  # --- ssh_exporter ---------------------------------------------------------
  - path: /opt/stack/ssh_exporter/ssh_exporter.yaml
    permissions: '0644'
    content: |
      ${indent(6, ssh_exporter_conf)}
%{ endif ~}

  # --- the compose stack itself ---------------------------------------------
  - path: /opt/stack/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, compose_conf)}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}
%{ if enable_heimdall && enable_heimdall_seed ~}

  # --- heimdall seed tool (uv single-file CLI) ------------------------------
  - path: /opt/stack/heimdall/heimdall_cli.py
    permissions: '0755'
    content: |
      ${indent(6, heimdall_cli_py)}
%{ endif ~}
%{ if log_shipping_target != "" ~}

  # Cross-cluster log shipping — syslog-ng client drop-in (shared snippet) shipping journald +
  # syslog-ng internal() to the centralized_logging collector. See specs/cross-cluster.md.
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, syslog_client_conf)}
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}
%{ if use_internal_tls ~}

  # --- Internal-CA TLS (Phase 2) — issue a Traefik leaf from step-ca + serve it on :443 ----------
  # step-ca JWK provisioner password (= centralized_pki's stepca_ca_password). |- strips the trailing newline.
  - path: /opt/stack/secrets/provisioner_password
    permissions: '0600'
    content: |-
      ${stepca_ca_password}

  # Fetch step-ca's root + issue the Traefik leaf via the JWK "admin" provisioner (shared snippet).
  # Re-runnable: the renew timer calls it again and Traefik's file-watch reloads the rotated cert.
  - path: /usr/local/sbin/issue-cert.sh
    permissions: '0755'
    content: |
      ${indent(6, issue_cert_sh)}

  # Traefik file-provider dynamic config — HTTPS routers per enabled service + the leaf as default cert.
  - path: /opt/stack/traefik/dynamic.yaml
    permissions: '0644'
    content: |
      ${indent(6, traefik_dynamic)}

  - path: /etc/systemd/system/monitoring-cert-renew.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Reissue the Traefik cert from step-ca
      After=docker.service
      Wants=docker.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/issue-cert.sh

  - path: /etc/systemd/system/monitoring-cert-renew.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Renew the Traefik cert from step-ca every 12h
      [Timer]
      OnBootSec=12h
      OnUnitActiveSec=12h
      [Install]
      WantedBy=timers.target
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins.
  # Harmless on Proxmox (already UTC). See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  - mkdir -p /opt/stack
  - curl -fsSL https://get.docker.com | sh
  - usermod -aG docker ubuntu  # let the SSH user reach the docker socket (heimdall CLI remote transport)
  - systemctl enable docker
  - systemctl restart docker
%{ if use_internal_tls ~}
  # Internal-CA TLS (Phase 2): issue the Traefik leaf from step-ca BEFORE the stack starts (so
  # Traefik finds the cert on disk), then arm the 12h renew timer. See specs/internal-ca.md.
  - mkdir -p /opt/stack/traefik/certs /opt/stack/secrets
  - /usr/local/sbin/issue-cert.sh
  - systemctl daemon-reload
  - systemctl enable --now monitoring-cert-renew.timer
%{ endif ~}
  - docker compose -f /opt/stack/compose.yaml up -d
%{ if enable_openobserve ~}
  # Seed the app-OTLP streams (otlp_logs logs+traces) and import the OpenObserve dashboards, once
  # the stack is up. Best-effort (|| true) so a slow/again-failing OpenObserve can't break the boot;
  # the script waits for OpenObserve health itself and is idempotent. Credentials via env, not argv.
  - OO_ORG='${openobserve_org}' OO_PASS='${openobserve_password}' /usr/local/sbin/openobserve-provision.sh || true
%{ endif ~}
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ if enable_netdata ~}
  # netdata — real-time agent (:19999, /api/v1/allmetrics?format=prometheus).
  # Standalone/local-only: no --claim-token (no Netdata Cloud), telemetry disabled, updates pinned.
  # Host-installed (not compose); Prometheus reaches it via host.docker.internal (see compose.yaml).
  - mkdir -p /etc/netdata && touch /etc/netdata/.opt-out-from-anonymous-statistics
  - curl -sSLf https://get.netdata.cloud/kickstart.sh -o /tmp/netdata-kickstart.sh && DO_NOT_TRACK=1 sh /tmp/netdata-kickstart.sh --non-interactive --stable-channel --disable-telemetry --no-updates --dont-wait || true
  # scripts.d must exist or netdata's external-plugins scanner logs a repeating warning
  - mkdir -p /etc/netdata/scripts.d && chown -R netdata:netdata /etc/netdata/scripts.d || true
  # netdata's built-in StatsD collector is on by default and binds :8125 (UDP+TCP),
  # colliding with this cluster's own statsd_exporter container (used for Locust
  # StatsD load testing) — disable it so statsd_exporter can claim the port.
  - printf '\n[plugins]\n\tstatsd = no\n' >> /etc/netdata/netdata.conf && systemctl restart netdata || true
%{ endif ~}
%{ if enable_heimdall && enable_heimdall_seed ~}
  # --- auto-seed Heimdall tiles (best-effort; never fails the boot) ----------
  - curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh || true
  - |
    i=0
    until docker compose -f /opt/stack/compose.yaml exec -T heimdall test -f /config/www/app.sqlite; do
      i=$((i+1)); [ $i -ge 60 ] && break; sleep 5
    done
  - |
    IP=$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')
    /usr/local/bin/uv run /opt/stack/heimdall/heimdall_cli.py seed \
      --compose-file /opt/stack/compose.yaml \
      --server-ip "$IP" \
      --enabled "${heimdall_seed_flags}" \
      --prune || true
%{ endif ~}
%{ if log_shipping_target != "" ~}
  # Cross-cluster syslog-ng shipper — install, ensure the drop-in is @included, restart.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y syslog-ng
  - mkdir -p /var/lib/syslog-ng
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}

final_message: "monitoring server ready — prometheus :9090 / grafana :3000 / openobserve :5080"
