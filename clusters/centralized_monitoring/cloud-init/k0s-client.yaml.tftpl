#cloud-config
# Monitored host — single-node k0s + the enabled exporter bundle. "Anything that can
# be monitored should be." Because this is an Ubuntu host running k0s, enabled exporters
# cover BOTH layers: the OS (node_exporter incl. systemd, process-exporter, netdata, and
# the Reach/Nice host exporters) and the k8s node (kube-state-metrics + kubelet/cAdvisor).
# Each exporter's install block is gated on its enable_* flag, so the footprint scales
# with what is turned on. Prometheus on the server PULLS these — no server IP is needed
# here (that would create a dependency cycle; client-side OTLP push is Future work).
#
# NOTE on arch: install-exporter.sh substitutes {ARCH} (arm64/amd64, from dpkg) into each
# release URL so the bundle works on Apple-Silicon Multipass (arm64) and amd64 Proxmox alike.
package_update: true
package_upgrade: true

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so log/metric timestamps align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - tar
  - vim
  - htop
  - jq
  - ccze

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # Generic exporter installer: download a GitHub release (tar.gz or raw binary),
  # drop the binary in /usr/local/bin, and install + enable a systemd unit for it.
  # {ARCH} in the URL is replaced with the host's Debian arch (arm64/amd64).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"

  # Debug CLI installer: download a GitHub release (tar.gz or raw binary) and drop the
  # binary in /usr/local/bin. Same arch/{ARCH} handling as install-exporter.sh, minus the
  # systemd unit — k9s/stern are interactive CLIs, not daemons.
  - path: /usr/local/sbin/install-cli.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
%{ if enable_process_exporter ~}
  # process-exporter config: curated groups so multi-process apps aggregate; a final
  # {{.Comm}} catch-all keeps the long tail as one bounded group per command (empty
  # groups pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: container-runtime
          exe: [ dockerd, containerd, containerd-shim-runc-v2, runc ]
        - name: kubernetes
          exe: [ k0s, kubelet, kube-router, etcd ]
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}
%{ if enable_filestat_exporter ~}
  # filestat_exporter config: stat a couple of always-present files so it emits metrics.
  - path: /etc/filestat_exporter/filestat.yaml
    permissions: '0644'
    content: |
      exporter:
        files:
          - patterns:
              - '/var/log/syslog'
              - '/etc/hostname'
%{ endif ~}
%{ if enable_kube_state_metrics ~}
  # kube-state-metrics runs as a hostNetwork Deployment (upstream no longer ships a standalone
  # binary, and a ClusterIP Service is unreachable from the server). hostNetwork binds the k0s
  # host's :8081 directly, and it authenticates with the k0s admin kubeconfig mounted from the
  # host (the kubeconfig's apiserver address — the node IP:6443 — is reachable on the host netns).
  - path: /etc/kube-state-metrics/deployment.yaml
    permissions: '0644'
    content: |
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: kube-state-metrics
        namespace: kube-system
        labels:
          app.kubernetes.io/name: kube-state-metrics
      spec:
        replicas: 1
        selector:
          matchLabels:
            app.kubernetes.io/name: kube-state-metrics
        template:
          metadata:
            labels:
              app.kubernetes.io/name: kube-state-metrics
          spec:
            hostNetwork: true
            containers:
              - name: kube-state-metrics
                image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.13.0
                args:
                  - --port=8081
                  - --telemetry-port=8082
                  - --kubeconfig=/etc/ksm/kubeconfig
                ports:
                  - containerPort: 8081
                    name: http-metrics
                  - containerPort: 8082
                    name: telemetry
                volumeMounts:
                  - name: kubeconfig
                    mountPath: /etc/ksm
                    readOnly: true
            volumes:
              - name: kubeconfig
                hostPath:
                  path: /etc/kube-state-metrics
                  type: Directory
%{ endif ~}
%{ if enable_k0s_log_shipping && enable_openobserve ~}
  # otelcol-contrib log-shipping agent config. The endpoint here is a 127.0.0.1 PLACEHOLDER:
  # the k0s VM is created before the server, so the server IP is unknown at boot. OpenTofu
  # re-renders this file with the real server IP and pushes it post-apply (see terraform_data
  # "k0s_log_shipper" in main.tf), then restarts the unit.
  - path: /etc/otelcol/collector-config.yaml
    permissions: '0644'
    content: |
      ${indent(6, k0s_otel_config)}
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins.
  # Harmless on Proxmox (already UTC). See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  # --- single-node k0s (controller + worker in one). The kubelet read-only port (10255,
  # http, no auth) is enabled so the server can scrape kubelet/cAdvisor without a token.
  - curl -sSLf https://get.k0s.sh | sh
  - /usr/local/bin/k0s install controller --single --kubelet-extra-args="--read-only-port=10255"
  - /usr/local/bin/k0s start
  # Debug CLIs (unconditional): k9s (terminal k8s UI) + stern (multi-pod log tail).
  - /usr/local/sbin/install-cli.sh k9s https://github.com/derailed/k9s/releases/download/v0.51.0/k9s_Linux_{ARCH}.tar.gz k9s
  - /usr/local/sbin/install-cli.sh stern https://github.com/stern/stern/releases/download/v1.34.0/stern_1.34.0_linux_{ARCH}.tar.gz stern
  # Admin kubeconfig for the ubuntu login so k9s/stern (and kubectl) work over SSH out-of-box.
  - mkdir -p /home/ubuntu/.kube
  - /usr/local/bin/k0s kubeconfig admin > /home/ubuntu/.kube/config
  - chown -R ubuntu:ubuntu /home/ubuntu/.kube
  - chmod 600 /home/ubuntu/.kube/config
%{ if enable_node_exporter ~}
  # node_exporter — OS host + systemd-unit metrics (:9100)
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.systemd
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558); host binary (needs D-Bus + /proc)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|docker|containerd|k0s.*|kube.*|.*[-_]exporter|cadvisor|netdata)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}
%{ if enable_cadvisor ~}
  # cAdvisor — container metrics (:8089; :8080 is taken by k0s kube-router on this host)
  - /usr/local/sbin/install-exporter.sh cadvisor https://github.com/google/cadvisor/releases/download/v0.49.1/cadvisor-v0.49.1-linux-{ARCH} cadvisor --port=8089
%{ endif ~}
%{ if enable_netdata ~}
  # netdata — real-time agent (:19999, /api/v1/allmetrics?format=prometheus).
  # Standalone/local-only: no --claim-token (no Netdata Cloud), telemetry disabled, updates pinned.
  - mkdir -p /etc/netdata && touch /etc/netdata/.opt-out-from-anonymous-statistics
  - curl -sSLf https://get.netdata.cloud/kickstart.sh -o /tmp/netdata-kickstart.sh && DO_NOT_TRACK=1 sh /tmp/netdata-kickstart.sh --non-interactive --stable-channel --disable-telemetry --no-updates --dont-wait || true
  # scripts.d must exist or netdata's external-plugins scanner logs a repeating warning
  - mkdir -p /etc/netdata/scripts.d && chown -R netdata:netdata /etc/netdata/scripts.d || true
  # netdata's built-in StatsD collector is on by default and binds :8125 (UDP+TCP);
  # disabled here for consistency with the server VM (see server.yaml.tftpl), even
  # though this node doesn't run statsd_exporter itself today.
  - printf '\n[plugins]\n\tstatsd = no\n' >> /etc/netdata/netdata.conf && systemctl restart netdata || true
%{ endif ~}
%{ if enable_kube_state_metrics ~}
  # kube-state-metrics — wait for the API, drop the admin kubeconfig next to the manifest, then
  # apply the hostNetwork Deployment so :8081 is reachable from the server at <k0s_ip>:8081.
  - until /usr/local/bin/k0s kubectl get --raw='/readyz' >/dev/null 2>&1; do sleep 5; done
  - mkdir -p /etc/kube-state-metrics && /usr/local/bin/k0s kubeconfig admin > /etc/kube-state-metrics/kubeconfig
  - /usr/local/bin/k0s kubectl apply -f /etc/kube-state-metrics/deployment.yaml
%{ endif ~}
%{ if enable_nut_exporter ~}
  # nut_exporter — UPS / Network UPS Tools metrics (:9199). Lab-hostile: needs a running
  # upsd/UPS, so this flag is off by default.
  - /usr/local/sbin/install-exporter.sh nut_exporter https://github.com/DRuggeri/nut_exporter/releases/download/v3.2.5/nut_exporter_3.2.5_linux_{ARCH}.tar.gz nut_exporter
%{ endif ~}
%{ if enable_nftables_exporter ~}
  # nftables_exporter — firewall rule counters (:9630). Lab-hostile: upstream ships a Python
  # tool (no portable binary release), so this flag is off by default.
  - /usr/local/sbin/install-exporter.sh nftables_exporter https://github.com/Sheridan/nftables_exporter/releases/download/2.1.0/nftables_exporter-2.1.0.linux-{ARCH}.tar.gz nftables_exporter
%{ endif ~}
%{ if enable_filestat_exporter ~}
  # filestat_exporter — file size / mtime / stat metrics (:9943)
  - /usr/local/sbin/install-exporter.sh filestat_exporter https://github.com/michael-doubez/filestat_exporter/releases/download/v0.4.5/filestat_exporter-v0.4.5.linux-{ARCH}.tar.gz filestat_exporter --config.file=/etc/filestat_exporter/filestat.yaml
%{ endif ~}
%{ if enable_osquery_exporter ~}
  # osquery_exporter — osquery query results -> metrics (:9450)
  - DEBIAN_FRONTEND=noninteractive apt-get install -y osquery || true
  - /usr/local/sbin/install-exporter.sh osquery_exporter https://github.com/zwopir/osquery_exporter/releases/download/v0.1.1/osquery_exporter-0.1.1.linux-{ARCH}.tar.gz osquery_exporter
%{ endif ~}
%{ if enable_ebpf_exporter ~}
  # ebpf_exporter — custom eBPF metrics (:9435). Needs kernel headers to compile probes.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y linux-headers-$(uname -r) || DEBIAN_FRONTEND=noninteractive apt-get install -y linux-headers-generic
  - /usr/local/sbin/install-exporter.sh ebpf_exporter https://github.com/cloudflare/ebpf_exporter/releases/download/v2.4.2/ebpf_exporter-2.4.2-linux-{ARCH}.tar.gz ebpf_exporter --config.dir=/etc/ebpf_exporter
%{ endif ~}
%{ if enable_texporter ~}
  # texporter — eBPF network-traffic metrics (:9101). Needs kernel headers.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y linux-headers-$(uname -r) || DEBIAN_FRONTEND=noninteractive apt-get install -y linux-headers-generic
  - /usr/local/sbin/install-exporter.sh texporter https://github.com/wobcom/texporter/releases/download/v0.1.0/texporter-0.1.0.linux-{ARCH}.tar.gz texporter
%{ endif ~}
%{ if enable_ffmpeg_exporter ~}
  # ffmpeg_exporter — FFmpeg job metrics (:9618), only with media workloads
  - DEBIAN_FRONTEND=noninteractive apt-get install -y ffmpeg || true
  - /usr/local/sbin/install-exporter.sh ffmpeg_exporter https://github.com/projectkudu/ffmpeg_exporter/releases/download/v0.1.0/ffmpeg_exporter-0.1.0.linux-{ARCH}.tar.gz ffmpeg_exporter
%{ endif ~}
%{ if enable_script_exporter ~}
  # script_exporter — arbitrary shell-script metrics (:9469)
  - /usr/local/sbin/install-exporter.sh script_exporter https://github.com/ricoberger/script_exporter/releases/download/v2.18.0/script_exporter-2.18.0.linux-{ARCH}.tar.gz script_exporter
%{ endif ~}
%{ if enable_k0s_log_shipping && enable_openobserve ~}
  # otelcol-contrib — ships the k0s host syslog + Kubernetes pod logs to the server's
  # OpenObserve (k0s_host / k0s_pods streams). Runs as root so it can read /var/log/pods.
  # The config written above uses a 127.0.0.1 placeholder endpoint until OpenTofu pushes the
  # real server IP post-apply and restarts this unit.
  # Offset dir for the file_storage extension must exist before the unit starts (otelcol
  # errors if the directory is missing) — persists filelog offsets across restarts.
  - mkdir -p /var/lib/otelcol-contrib/storage
  - /usr/local/sbin/install-exporter.sh otelcol-contrib https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v0.117.0/otelcol-contrib_0.117.0_linux_{ARCH}.tar.gz otelcol-contrib --config=/etc/otelcol/collector-config.yaml
%{ endif ~}

final_message: "k0s monitored host ready — k0s status; exporters scraped by the server"
