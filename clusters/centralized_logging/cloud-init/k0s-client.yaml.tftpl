#cloud-config
# Client VM — single-node k0s cluster + syslog-ng shipper + the metrics exporter layer.
# Exporters bind 0.0.0.0 (no local scrape — a future centralized_monitoring Prometheus pulls
# them). Each install block is gated on its enable_* flag. See specs/centralized_logging_metrics.md.
package_update: true
package_upgrade: true

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so log/metric timestamps align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - syslog-ng
  - curl
  - tar
  - vim
  - htop
  - jq
  - ccze

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, client_conf)}

  # Generic exporter installer (copied from the centralized_monitoring cluster).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"

  # Debug CLI installer: download a GitHub release (tar.gz or raw binary) and drop the
  # binary in /usr/local/bin. Same arch/{ARCH} handling as install-exporter.sh, minus the
  # systemd unit — k9s/stern are interactive CLIs, not daemons.
  - path: /usr/local/sbin/install-cli.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
%{ if enable_syslogng_metrics ~}
  # syslog-ng metrics via node_exporter textfile collector.
  - path: /usr/local/sbin/syslogng-textfile.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      out=/var/lib/node_exporter/textfile_collector/syslogng.prom
      tmp="$(mktemp)"
      /usr/sbin/syslog-ng-ctl stats prometheus > "$tmp" 2>/dev/null || true
      mv "$tmp" "$out"
  - path: /etc/systemd/system/syslogng-textfile.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Write syslog-ng prometheus stats to the node_exporter textfile collector
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/syslogng-textfile.sh
  - path: /etc/systemd/system/syslogng-textfile.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh syslog-ng textfile metrics every 15s
      [Timer]
      OnBootSec=30
      OnUnitActiveSec=15
      [Install]
      WantedBy=timers.target
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter config: curated groups so multi-process apps aggregate; a final
  # {{.Comm}} catch-all keeps the long tail as one bounded group per command (empty
  # groups pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: syslog-ng
          exe: [ syslog-ng ]
        - name: container-runtime
          exe: [ dockerd, containerd, containerd-shim-runc-v2, runc ]
        - name: kubernetes
          exe: [ k0s, kubelet, kube-router, etcd ]
        - name: observability
          exe: [ prometheus, grafana, grafana-server, alertmanager, traefik ]
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}
%{ if enable_kube_state_metrics ~}
  # kube-state-metrics runs as a hostNetwork Deployment (binds the host's :8081 directly) and
  # authenticates with the k0s admin kubeconfig mounted from the host.
  - path: /etc/kube-state-metrics/deployment.yaml
    permissions: '0644'
    content: |
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: kube-state-metrics
        namespace: kube-system
        labels:
          app.kubernetes.io/name: kube-state-metrics
      spec:
        replicas: 1
        selector:
          matchLabels:
            app.kubernetes.io/name: kube-state-metrics
        template:
          metadata:
            labels:
              app.kubernetes.io/name: kube-state-metrics
          spec:
            hostNetwork: true
            containers:
              - name: kube-state-metrics
                image: registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.13.0
                args:
                  - --port=8081
                  - --telemetry-port=8082
                  - --kubeconfig=/etc/ksm/kubeconfig
                ports:
                  - containerPort: 8081
                    name: http-metrics
                  - containerPort: 8082
                    name: telemetry
                volumeMounts:
                  - name: kubeconfig
                    mountPath: /etc/ksm
                    readOnly: true
            volumes:
              - name: kubeconfig
                hostPath:
                  path: /etc/kube-state-metrics
                  type: Directory
%{ endif ~}
%{ if enable_ingress ~}
  # ingress-nginx installer — bare-metal manifest patched to hostNetwork so the controller binds
  # the k0s VM's :80/:443 directly (the docker VM owns :80 on its own host, so no clash). Gives
  # Coroot's UI (and any future in-cluster HTTP service) a real ingress. See specs/coroot.md.
  - path: /usr/local/sbin/ingress-install.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      k="/usr/local/bin/k0s kubectl"
      mkdir -p /root/.kube && /usr/local/bin/k0s kubeconfig admin > /root/.kube/config
      export KUBECONFIG=/root/.kube/config
      until $k get --raw='/readyz' >/dev/null 2>&1; do sleep 5; done
      $k apply -f https://raw.githubusercontent.com/kubernetes/ingress-nginx/controller-v1.15.1/deploy/static/provider/baremetal/deploy.yaml
      $k -n ingress-nginx patch deployment ingress-nginx-controller --type=json -p '[{"op":"add","path":"/spec/template/spec/hostNetwork","value":true},{"op":"replace","path":"/spec/template/spec/dnsPolicy","value":"ClusterFirstWithHostNet"}]'
%{ endif ~}
%{ if enable_coroot ~}
  # Coroot Helm values (rendered by OpenTofu — overrides the chart's laptop-hostile defaults:
  # ClickHouse storage 100Gi and server memory 4Gi are both trimmed to fit the lab VM).
  - path: /etc/coroot/values.yaml
    permissions: '0644'
    content: |
      ${indent(6, coroot_values)}
  # Coroot installer — helm (arch-matched) + a default StorageClass (OpenEBS) + the coroot-operator
  # and coroot-ce charts. Self-hosted: no cloud account, no secrets. See specs/coroot.md.
  - path: /usr/local/sbin/coroot-install.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      k="/usr/local/bin/k0s kubectl"
      mkdir -p /root/.kube && /usr/local/bin/k0s kubeconfig admin > /root/.kube/config
      export KUBECONFIG=/root/.kube/config
      until $k get --raw='/readyz' >/dev/null 2>&1; do sleep 5; done
      # helm (arch-matched: arm64 on the lab's Apple-Silicon VMs, amd64 on Proxmox)
      if ! command -v helm >/dev/null 2>&1; then
        arch="$(dpkg --print-architecture)"
        curl -sSLf "https://get.helm.sh/helm-v3.21.2-linux-$arch.tar.gz" -o /tmp/helm.tgz
        tar -xzf /tmp/helm.tgz -C /tmp
        install -m0755 "/tmp/linux-$arch/helm" /usr/local/bin/helm
      fi
      # Default StorageClass for Coroot's bundled Prometheus/ClickHouse PVCs (k0s ships none).
      $k apply -f https://openebs.github.io/charts/openebs-operator-lite.yaml
      $k apply -f https://openebs.github.io/charts/openebs-lite-sc.yaml
      $k patch storageclass openebs-hostpath -p '{"metadata":{"annotations":{"storageclass.kubernetes.io/is-default-class":"true"}}}'
      # Strip OpenEBS NDM (Node Disk Manager). openebs-operator-lite bundles it, but NDM only
      # backs the LocalPV-*device* engine (the openebs-device SC) which this lab never uses — every
      # Coroot PVC binds to openebs-hostpath, served by the localpv-provisioner (left intact below).
      # NDM leaks to ~4Gi, runs besteffort (no mem limit), and triggers a *global* OOM that thrashes
      # the whole VM (load 15+, kube-apiserver TLS timeouts). Delete it (apply-then-delete keeps this
      # idempotent — a re-run re-applies the manifest then re-strips NDM in the same pass).
      # See specs/centralized-logging-k0s-perf.md.
      $k -n openebs delete daemonset  openebs-ndm openebs-ndm-node-exporter         --ignore-not-found
      $k -n openebs delete deployment openebs-ndm-operator openebs-ndm-cluster-exporter --ignore-not-found
      $k -n openebs delete configmap  openebs-ndm-config                            --ignore-not-found
      $k delete storageclass openebs-device                                         --ignore-not-found
      # Coroot: operator first (installs the Coroot CRD), then coroot-ce (creates a Coroot CR the
      # operator reconciles into server + node-agent + cluster-agent + Prometheus + ClickHouse).
      helm repo add --force-update coroot https://coroot.github.io/helm-charts
      helm repo update coroot
      helm upgrade --install -n coroot --create-namespace coroot-operator coroot/coroot-operator ${coroot_operator_version_flag}
      for i in $(seq 1 30); do $k get crd coroots.coroot.com >/dev/null 2>&1 && break; sleep 5; done
      helm upgrade --install -n coroot coroot coroot/coroot-ce -f /etc/coroot/values.yaml ${coroot_ce_version_flag}
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins.
  # Harmless on Proxmox (already UTC). See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
  # syslog-ng shipper
  - mkdir -p /var/lib/syslog-ng
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
  # k0s single node (controller + worker in one). The kubelet read-only port (10255, http,
  # no auth) is enabled when enable_kube_metrics so kubelet/cAdvisor scrape with no token.
  - curl -sSLf https://get.k0s.sh | sh
%{ if enable_kube_metrics ~}
  - /usr/local/bin/k0s install controller --single --kubelet-extra-args="--read-only-port=10255"
%{ else ~}
  - /usr/local/bin/k0s install controller --single
%{ endif ~}
  - /usr/local/bin/k0s start
  # Debug CLIs (unconditional): k9s (terminal k8s UI) + stern (multi-pod log tail).
  - /usr/local/sbin/install-cli.sh k9s https://github.com/derailed/k9s/releases/download/v0.51.0/k9s_Linux_{ARCH}.tar.gz k9s
  - /usr/local/sbin/install-cli.sh stern https://github.com/stern/stern/releases/download/v1.34.0/stern_1.34.0_linux_{ARCH}.tar.gz stern
  # Admin kubeconfig for the ubuntu login so k9s/stern (and kubectl) work over SSH out-of-box.
  - mkdir -p /home/ubuntu/.kube
  - /usr/local/bin/k0s kubeconfig admin > /home/ubuntu/.kube/config
  - chown -R ubuntu:ubuntu /home/ubuntu/.kube
  - chmod 600 /home/ubuntu/.kube/config
%{ if enable_node_exporter || enable_syslogng_metrics ~}
  - mkdir -p /var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if enable_node_exporter ~}
  # node_exporter — OS host + systemd-unit metrics (:9100); also serves the syslog-ng .prom.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.systemd --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if enable_syslogng_metrics ~}
  - systemctl enable --now syslogng-textfile.timer
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|syslog-ng|docker|containerd|k0s.*|kube.*|.*[-_]exporter|cadvisor|prometheus|grafana|alertmanager|traefik|heimdall)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_journald_exporter ~}
  # journald-exporter (:12345) — x86-64-only upstream binary; best-effort (amd64 only).
  - mkdir -p /etc/journald-exporter/keys
  - /usr/local/sbin/install-exporter.sh journald-exporter https://github.com/dead-claudia/journald-exporter/releases/download/v1.0.0/journald-exporter journald-exporter --port=12345 --key-dir=/etc/journald-exporter/keys || true
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}
%{ if enable_cadvisor ~}
  # cAdvisor — container metrics (:8089; :8080 is taken by k0s kube-router on this host)
  - /usr/local/sbin/install-exporter.sh cadvisor https://github.com/google/cadvisor/releases/download/v0.49.1/cadvisor-v0.49.1-linux-{ARCH} cadvisor --port=8089
%{ endif ~}
%{ if enable_kube_state_metrics ~}
  # kube-state-metrics — wait for the API, drop the admin kubeconfig, apply the hostNetwork
  # Deployment so :8081 is reachable on the host.
  - until /usr/local/bin/k0s kubectl get --raw='/readyz' >/dev/null 2>&1; do sleep 5; done
  - mkdir -p /etc/kube-state-metrics && /usr/local/bin/k0s kubeconfig admin > /etc/kube-state-metrics/kubeconfig
  - /usr/local/bin/k0s kubectl apply -f /etc/kube-state-metrics/deployment.yaml
%{ endif ~}
%{ if enable_ingress ~}
  # ingress-nginx (hostNetwork; binds :80/:443). Runs before Coroot so its Ingress has a class.
  - /usr/local/sbin/ingress-install.sh
%{ endif ~}
%{ if enable_coroot ~}
  # Coroot stack (helm: operator + coroot-ce). Deploys asynchronously — pods come up after boot;
  # `just coroot-status` / `just verify` watch for readiness. UI on the NodePort (+ ingress).
  - /usr/local/sbin/coroot-install.sh
%{ endif ~}

final_message: "k0s client ready — k0s status; shipping logs to central; exporters on :9100/:9558/:9256/:8089 (+kube :10249/:10255/:8081)"
