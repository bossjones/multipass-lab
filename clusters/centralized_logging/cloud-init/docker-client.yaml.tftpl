#cloud-config
# Client VM — Docker stack (Traefik, Heimdall, Grafana, Prometheus, Alertmanager)
# + syslog-ng shipper. Docker's journald log-driver routes all container logs into
# journald, which syslog-ng's system() source ships to central.
package_update: true
package_upgrade: true

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so log/metric timestamps align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - syslog-ng
  - curl
  - tar
  - vim
  - htop
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, client_conf)}

  # Generic exporter installer (copied from the centralized_monitoring cluster).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"
%{ if enable_syslogng_metrics ~}
  # syslog-ng metrics via node_exporter textfile collector.
  - path: /usr/local/sbin/syslogng-textfile.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      out=/var/lib/node_exporter/textfile_collector/syslogng.prom
      tmp="$(mktemp)"
      /usr/sbin/syslog-ng-ctl stats prometheus > "$tmp" 2>/dev/null || true
      mv "$tmp" "$out"
  - path: /etc/systemd/system/syslogng-textfile.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Write syslog-ng prometheus stats to the node_exporter textfile collector
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/syslogng-textfile.sh
  - path: /etc/systemd/system/syslogng-textfile.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Refresh syslog-ng textfile metrics every 15s
      [Timer]
      OnBootSec=30
      OnUnitActiveSec=15
      [Install]
      WantedBy=timers.target
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter config: curated groups so multi-process apps aggregate; a final
  # {{.Comm}} catch-all keeps the long tail as one bounded group per command (empty
  # groups pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: syslog-ng
          exe: [ syslog-ng ]
        - name: container-runtime
          exe: [ dockerd, containerd, containerd-shim-runc-v2, runc ]
        - name: kubernetes
          exe: [ k0s, kubelet, kube-router, etcd ]
        - name: observability
          exe: [ prometheus, grafana, grafana-server, alertmanager, traefik ]
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}

  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "journald"
      }

  # Prometheus now self-monitors all three cluster VMs. central/k0s IPs are injected at
  # render time (the dependency edge); __SELF_IP__ is this docker VM's own host IP, which
  # can't be self-referenced in tofu, so it is substituted at boot by a runcmd sed before
  # the stack starts. Jobs mirror cloud-init/prometheus/logging-scrape.yml and are gated by
  # the same enable_* flags that install each exporter. See specs/dashboards.md.
  - path: /opt/stack/prometheus.yml
    permissions: '0644'
    content: |
      global:
        scrape_interval: 15s
      scrape_configs:
        - job_name: prometheus
          static_configs:
            - targets: ["localhost:9090"]
%{ if enable_traefik_metrics ~}
        - job_name: logging-traefik
          static_configs:
            - targets: ["traefik:8082"]
%{ endif ~}
%{ if enable_node_exporter ~}
        - job_name: logging-node        # host metrics + syslog-ng textfile metrics
          static_configs:
            - targets: ["${central_ip}:9100", "__SELF_IP__:9100", "${k0s_ip}:9100"]
%{ endif ~}
%{ if enable_systemd_exporter ~}
        - job_name: logging-systemd
          static_configs:
            - targets: ["${central_ip}:9558", "__SELF_IP__:9558", "${k0s_ip}:9558"]
%{ endif ~}
%{ if enable_journald_exporter ~}
        - job_name: logging-journald    # only when enable_journald_exporter (amd64 hosts)
          static_configs:
            - targets: ["${central_ip}:12345", "__SELF_IP__:12345", "${k0s_ip}:12345"]
%{ endif ~}
%{ if enable_process_exporter ~}
        - job_name: logging-process
          static_configs:
            - targets: ["${central_ip}:9256", "__SELF_IP__:9256", "${k0s_ip}:9256"]
%{ endif ~}
%{ if enable_filestat_exporter ~}
        - job_name: logging-filestat    # central only (/var/log/remote freshness)
          static_configs:
            - targets: ["${central_ip}:9943"]
%{ endif ~}
%{ if enable_cadvisor ~}
        - job_name: logging-cadvisor    # docker + k0s hosts
          static_configs:
            - targets: ["__SELF_IP__:8089", "${k0s_ip}:8089"]
%{ endif ~}
%{ if enable_kube_metrics ~}
        - job_name: logging-kube        # kube-proxy on the k0s host
          static_configs:
            - targets: ["${k0s_ip}:10249"]
        - job_name: logging-kubelet-cadvisor
          metrics_path: /metrics/cadvisor
          static_configs:
            - targets: ["${k0s_ip}:10255"]
%{ endif ~}
%{ if enable_kube_state_metrics ~}
        - job_name: logging-kube-state
          static_configs:
            - targets: ["${k0s_ip}:8081"]
%{ endif ~}

  - path: /opt/stack/alertmanager.yml
    permissions: '0644'
    content: |
      route:
        receiver: "devnull"
      receivers:
        - name: "devnull"

  # --- Grafana provisioning (datasource + dashboard provider + drop-a-file dashboards) ---
  - path: /opt/stack/grafana/provisioning/datasources/datasources.yaml
    permissions: '0644'
    content: |
      ${indent(6, grafana_datasources)}

  - path: /opt/stack/grafana/provisioning/dashboards/dashboards.yaml
    permissions: '0644'
    content: |
      ${indent(6, grafana_dash_prov)}
%{ for d in grafana_dashboards ~}
  - path: /opt/stack/grafana/dashboards/${d.name}
    permissions: '0644'
    encoding: gz+b64
    content: ${base64gzip(d.content)}
%{ endfor ~}

  - path: /opt/stack/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, compose_conf)}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins.
  # Harmless on Proxmox (already UTC). See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
  # syslog-ng shipper
  - mkdir -p /var/lib/syslog-ng /opt/stack
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
  # Docker + stack
  - mkdir -p /etc/docker
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl restart docker
  # Substitute this VM's own LAN IP into prometheus.yml so the local Prometheus can scrape
  # the host-level exporters running on this docker VM (they bind 0.0.0.0, not the compose net).
  - |
    SELF_IP=$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')
    sed -i "s/__SELF_IP__/$SELF_IP/g" /opt/stack/prometheus.yml
  - docker compose -f /opt/stack/compose.yaml up -d
%{ if enable_node_exporter || enable_syslogng_metrics ~}
  - mkdir -p /var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if enable_node_exporter ~}
  # node_exporter — OS host + systemd-unit metrics (:9100); also serves the syslog-ng .prom.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter --collector.systemd --collector.textfile.directory=/var/lib/node_exporter/textfile_collector
%{ endif ~}
%{ if enable_syslogng_metrics ~}
  - systemctl enable --now syslogng-textfile.timer
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|syslog-ng|docker|containerd|k0s.*|kube.*|.*[-_]exporter|cadvisor|prometheus|grafana|alertmanager|traefik|heimdall)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_journald_exporter ~}
  # journald-exporter (:12345) — x86-64-only upstream binary; best-effort (amd64 only).
  - mkdir -p /etc/journald-exporter/keys
  - /usr/local/sbin/install-exporter.sh journald-exporter https://github.com/dead-claudia/journald-exporter/releases/download/v1.0.0/journald-exporter journald-exporter --port=12345 --key-dir=/etc/journald-exporter/keys || true
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}
%{ if enable_cadvisor ~}
  # cAdvisor — container metrics (:8089; :8080 is taken by the Traefik dashboard on this host)
  - /usr/local/sbin/install-exporter.sh cadvisor https://github.com/google/cadvisor/releases/download/v0.49.1/cadvisor-v0.49.1-linux-{ARCH} cadvisor --port=8089
%{ endif ~}

final_message: "docker client ready — stack on :80/:8080/:3000/:9090/:9093; exporters on :9100/:9558/:9256/:8089; shipping logs to central"
