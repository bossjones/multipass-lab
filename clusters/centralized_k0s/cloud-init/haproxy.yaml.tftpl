#cloud-config
# HAProxy control-plane edge VM — rendered ONLY in HA mode (k0s_control_plane_count > 1); a plain
# 1-controller `just up` creates no HAProxy and points externalAddress straight at controller-1.
#
# This is the SPOF edge in the lab's "etcd-quorum HA behind a single load balancer" story (full
# CPLB+NLLB HA is the Proxmox target). It does L4 passthrough (mode tcp) for the three control-plane
# ports — 6443 apiserver, 8132 konnectivity, 9443 controller-join — to every controller, and exposes
# HAProxy's NATIVE Prometheus exporter (no sidecar) on :8405/metrics for the monitoring hub.
# No API-dependent bootstrap here: HAProxy just forwards TCP; the cluster forms via k0sctl post-apply.
# See specs/centralized_k0s.md § "Control-plane HA + load balancer (HAProxy, conditional)".
package_update: false
package_upgrade: false

${ntp_timesync}

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  # Staged HAProxy config — copied into place by a runcmd AFTER `apt-get install haproxy`, so the
  # package's default /etc/haproxy/haproxy.cfg (unpacked on fresh install) can't clobber ours.
  - path: /etc/haproxy/haproxy.cfg.tofu
    permissions: '0644'
    content: |
      global
        log /dev/log local0
        maxconn 4096
        daemon

      defaults
        mode tcp
        log global
        option tcplog
        option dontlognull
        timeout connect 10s
        timeout client 1h
        timeout server 1h

      # --- L4 passthrough: kube-apiserver (6443) ---------------------------------
      frontend apiserver
        bind :6443
        mode tcp
        default_backend apiserver

      backend apiserver
        mode tcp
        balance roundrobin
        option tcp-check
%{ for idx, ip in controller_ips ~}
        server controller-${idx + 1} ${ip}:6443 check
%{ endfor ~}

      # --- L4 passthrough: konnectivity (8132) -----------------------------------
      frontend konnectivity
        bind :8132
        mode tcp
        default_backend konnectivity

      backend konnectivity
        mode tcp
        balance roundrobin
        option tcp-check
%{ for idx, ip in controller_ips ~}
        server controller-${idx + 1} ${ip}:8132 check
%{ endfor ~}

      # --- L4 passthrough: controller join API (9443) ----------------------------
      frontend controllerjoin
        bind :9443
        mode tcp
        default_backend controllerjoin

      backend controllerjoin
        mode tcp
        balance roundrobin
        option tcp-check
%{ for idx, ip in controller_ips ~}
        server controller-${idx + 1} ${ip}:9443 check
%{ endfor ~}

      # --- Native Prometheus exporter (:8405/metrics), scraped by the monitoring hub -----
      frontend prometheus
        bind :8405
        mode http
        http-request use-service prometheus-exporter if { path /metrics }
        no log
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if ntp_server != "" ~}

  # Internal NTP source — point systemd-timesyncd at the lab NTP server (shared snippet). See specs/shared-ntp.md.
  - path: /etc/systemd/timesyncd.conf.d/99-centralized-ntp.conf
    permissions: '0644'
    content: |
      ${indent(6, ntp_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}
%{ if enable_netdata ~}

  # Netdata agent (shared snippet) — installed by a runcmd below; serves the Prometheus endpoint
  # on :19999 (/api/v1/allmetrics?format=prometheus). See specs/shared-netdata.md.
  - path: /usr/local/sbin/install-netdata.sh
    permissions: '0755'
    content: |
      ${indent(6, netdata_installer)}
%{ endif ~}

runcmd:
  # Enforce UTC late (Multipass injects the host timezone at first boot — see specs/ntp.md).
  - timedatectl set-timezone Etc/UTC
%{ if ntp_server != "" ~}
  # Internal NTP source — apply the timesyncd drop-in written above. See specs/shared-ntp.md.
  - systemctl restart systemd-timesyncd
%{ endif ~}
  # UNCONDITIONAL resolver warm-up gate (boot-race hardening — runcmd is /bin/sh with no set -e, so
  # a first-boot DNS miss would silently break the apt/netdata fetches below). Applies the DNS
  # drop-in if one was written, then blocks until the hosts we actually hit resolve.
  - systemctl restart systemd-resolved
  - |
    for h in archive.ubuntu.com security.ubuntu.com github.com; do
      for i in $(seq 1 30); do getent hosts "$h" >/dev/null 2>&1 && break; sleep 2; done
    done
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  # Install HAProxy with bounded retry (DNS may still be warming; keep boot inside the 300s window).
  - |
    for i in $(seq 1 5); do apt-get update && apt-get install -y haproxy && break; sleep 5; done
  # Now that the package (and its default config) is unpacked, drop our L4 + metrics config in place.
  - cp /etc/haproxy/haproxy.cfg.tofu /etc/haproxy/haproxy.cfg
  - systemctl enable haproxy
  - systemctl restart haproxy
%{ if enable_netdata ~}
  # Netdata agent — install + tune for max stats (best-effort; idempotent re-run:
  # `sudo /usr/local/sbin/install-netdata.sh`). Serves :19999. See specs/shared-netdata.md.
  - /usr/local/sbin/install-netdata.sh || true
%{ endif ~}
