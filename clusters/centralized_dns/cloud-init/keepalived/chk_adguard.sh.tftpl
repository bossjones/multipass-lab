#!/bin/sh
# vrrp_script health probe: verify AdGuard Home actually ANSWERS DNS, not just that the process
# is alive, so the VIP leaves a node whose resolver is hung (not just crashed). Same probe target
# as the first-boot AdGuard-answering poll loop in cloud-init/server.yaml.tftpl.
exec dig +short +time=1 +tries=1 @127.0.0.1 example.com >/dev/null 2>&1
