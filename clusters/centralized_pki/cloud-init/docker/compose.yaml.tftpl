# Services stack for the services VM: Traefik terminates TLS in front of Authelia (forward-auth
# SSO) and Vaultwarden. Traefik serves step-ca's directly-issued default cert (default mode) or a
# Let's Encrypt staging wildcard via DNS-01 (enable_letsencrypt_staging). Routers just set tls=true
# and pick up whichever default cert the TLS store provides.
name: pki-services

services:
  traefik:
    image: traefik:v3.1
    container_name: traefik
    restart: unless-stopped
    command:
      - "--configfile=/etc/traefik/traefik.yaml"
    ports:
      - "80:80"
      - "443:443"
      - "8080:8080"
%{ if enable_letsencrypt_staging ~}
    environment:
      - GODADDY_API_KEY=${godaddy_api_key}
      - GODADDY_API_SECRET=${godaddy_api_secret}
      - GODADDY_PROPAGATION_TIMEOUT=600
      - GODADDY_POLLING_INTERVAL=30
%{ endif ~}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /opt/stack/traefik:/etc/traefik

  authelia:
    image: authelia/authelia:4.38
    container_name: authelia
    restart: unless-stopped
    expose:
      - "9091"
    volumes:
      - /opt/stack/authelia:/config
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.authelia.rule=Host(`auth.${domain}`)"
      - "traefik.http.routers.authelia.entrypoints=websecure"
      - "traefik.http.routers.authelia.tls=true"
      - "traefik.http.services.authelia.loadbalancer.server.port=9091"

  vaultwarden:
    image: vaultwarden/server:1.32.0
    container_name: vaultwarden
    restart: unless-stopped
    environment:
      - DOMAIN=https://vault.${domain}
      - SIGNUPS_ALLOWED=false
%{ if vaultwarden_admin_token != "" ~}
      - ADMIN_TOKEN=${vaultwarden_admin_token}
%{ endif ~}
    volumes:
      - vaultwarden_data:/data
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.vault.rule=Host(`vault.${domain}`)"
      - "traefik.http.routers.vault.entrypoints=websecure"
      - "traefik.http.routers.vault.tls=true"
      - "traefik.http.services.vault.loadbalancer.server.port=80"
      # /admin is gated by Authelia forward-auth (higher-priority router for the /admin path).
      - "traefik.http.routers.vaultadmin.rule=Host(`vault.${domain}`) && PathPrefix(`/admin`)"
      - "traefik.http.routers.vaultadmin.entrypoints=websecure"
      - "traefik.http.routers.vaultadmin.tls=true"
      - "traefik.http.routers.vaultadmin.service=vault"
      - "traefik.http.routers.vaultadmin.middlewares=authelia@file"

volumes:
  vaultwarden_data:
