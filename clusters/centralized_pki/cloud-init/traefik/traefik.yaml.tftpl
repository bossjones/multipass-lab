# Traefik static config.
#
# Default mode: Traefik serves a cert issued directly by step-ca (see dynamic.yaml's
# defaultCertificate); no ACME resolver, because the DNS-less lab can't satisfy step-ca's
# ACME challenge reachback. The file provider watches the cert dir so a renewed cert is
# picked up without a restart.
#
# enable_letsencrypt_staging mode: an ACME resolver named "stepca" points at Let's Encrypt
# STAGING via DNS-01 (GoDaddy) — DNS-01 needs no inbound reachback, so it works from the lab.
#
# providers.file.directory (not filename): pki's own base routes live in dynamic.yaml, and the
# fleet-wide routes traefik_cli.py hot-pushes land in a separate fleet.yaml — Traefik merges every
# *.yaml under the watched dir and hot-reloads on any change (no restart). See specs/dynamic-traefik.md.
api:
  dashboard: true
  insecure: true # dashboard on :8080 — lab only

entryPoints:
  web:
    address: ":80"
  websecure:
    address: ":443"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true
%{ if enable_letsencrypt_staging ~}

certificatesResolvers:
  stepca:
    acme:
      email: "${acme_email}"
      storage: /etc/traefik/acme/acme.json
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
      dnsChallenge:
        provider: godaddy
        delayBeforeCheck: 300
        resolvers:
          - "8.8.8.8:53"
%{ endif ~}
