# Traefik dynamic (file-provider) config: routers + services for Authelia and Vaultwarden, the
# Authelia forward-auth middleware, and the TLS default certificate. No docker provider — Traefik
# reaches the apps by container name over the compose network.
#
# Default mode: the default cert is the step-ca-issued leaf (SANs auth.<domain> + warden.<domain>),
# renewed in place by a host timer. enable_letsencrypt_staging mode: Traefik auto-generates a
# wildcard *.<domain> via the "stepca" ACME resolver (LE staging). Routers set tls: {} either way.
http:
  routers:
    authelia:
      rule: "Host(`auth.${domain}`)"
      entryPoints:
        - websecure
      service: authelia
      tls: {}
    warden:
      rule: "Host(`warden.${domain}`)"
      entryPoints:
        - websecure
      service: warden
      tls: {}
    # Higher-priority (longer rule) router for /admin, gated by Authelia forward-auth.
    wardenadmin:
      rule: "Host(`warden.${domain}`) && PathPrefix(`/admin`)"
      entryPoints:
        - websecure
      service: warden
      middlewares:
        - authelia
      tls: {}

  services:
    authelia:
      loadBalancer:
        servers:
          - url: "http://authelia:9091"
    warden:
      loadBalancer:
        servers:
          - url: "http://vaultwarden:80"

  middlewares:
    authelia:
      forwardAuth:
        address: "http://authelia:9091/api/authz/forward-auth"
        trustForwardHeader: true
        authResponseHeaders:
          - "Remote-User"
          - "Remote-Groups"
          - "Remote-Email"
          - "Remote-Name"

tls:
  stores:
    default:
%{ if enable_letsencrypt_staging ~}
      defaultGeneratedCert:
        resolver: stepca
        domain:
          main: "${domain}"
          sans:
            - "*.${domain}"
%{ else ~}
      defaultCertificate:
        certFile: /etc/traefik/certs/services.crt
        keyFile: /etc/traefik/certs/services.key
%{ endif ~}
