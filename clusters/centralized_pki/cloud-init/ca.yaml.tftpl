#cloud-config
# step-ca VM — private internal CA (smallstep/step-ca in Docker) exposing an ACME provisioner on
# :9000. Root + intermediate are generated at first boot; the root is fetched by the services VM
# to seed Traefik's trust. See specs/centralized_pki.md.
package_update: true
# No full package_upgrade: on the heavier services VM the apt dist-upgrade pushed first-boot past
# the multipass provider's launch timeout (an orphaned VM). The base 24.04 image is recent enough
# for a lab; kept symmetric across both VMs.
package_upgrade: false

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so cert notBefore/notAfter align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - tar
  - vim
  - htop
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /opt/pki/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, ca_compose)}

  # Generic exporter installer (copied from the centralized_logging cluster).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"
%{ if log_shipping_target != "" ~}

  # Cross-cluster log shipping — syslog-ng client drop-in (shared snippet) shipping journald +
  # syslog-ng internal() to the centralized_logging collector. See specs/cross-cluster.md.
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, syslog_client_conf)}
%{ endif ~}
%{ if openobserve_endpoint != "" ~}

  # Cross-cluster OTLP push — otelcol-contrib agent (shared snippet) shipping host logs to
  # centralized_monitoring's OpenObserve. See specs/cross-cluster.md.
  - path: /etc/otelcol-contrib/config.yaml
    permissions: '0644'
    content: |
      ${indent(6, otel_agent_conf)}
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins. See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
  # step-ca needs its own IP in the cert SAN, but tofu can't self-reference this VM's IP. Compute it
  # at boot and hand it to docker compose via /opt/pki/.env ($${SELF_IP} in the CA compose).
  - |
    SELF_IP=$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')
    echo "SELF_IP=$SELF_IP" > /opt/pki/.env
  # Docker + step-ca stack
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl restart docker
  - docker compose -f /opt/pki/compose.yaml up -d
%{ if enable_node_exporter ~}
  # node_exporter — OS host metrics (:9100), parity with the other clusters' metrics tests.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter
%{ endif ~}
%{ if log_shipping_target != "" ~}
  # Cross-cluster syslog-ng shipper — install, ensure the drop-in is @included, restart.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y syslog-ng
  - mkdir -p /var/lib/syslog-ng
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}
%{ if openobserve_endpoint != "" ~}
  # Cross-cluster OTLP agent — install the upstream otelcol-contrib .deb (arch-aware), then run
  # our rendered config. The .deb ships a systemd unit reading /etc/otelcol-contrib/config.yaml.
  - mkdir -p /var/lib/otelcol-contrib/storage
  - |
    OTEL_VER=0.109.0
    arch="$(dpkg --print-architecture)"
    curl -sSLf "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$${OTEL_VER}/otelcol-contrib_$${OTEL_VER}_linux_$${arch}.deb" -o /tmp/otelcol.deb
    DEBIAN_FRONTEND=noninteractive dpkg -i /tmp/otelcol.deb || DEBIAN_FRONTEND=noninteractive apt-get install -f -y
  - systemctl enable otelcol-contrib
  - systemctl restart otelcol-contrib
%{ endif ~}

final_message: "step-ca ready — ACME directory at https://ca.${domain}:9000/acme/acme/directory"
