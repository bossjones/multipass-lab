#cloud-config
# step-ca VM — private internal CA (smallstep/step-ca in Docker) exposing an ACME provisioner on
# :9000. Root + intermediate are generated at first boot; the root is fetched by the services VM
# to seed Traefik's trust. See specs/centralized_pki.md.
package_update: true
# No full package_upgrade: on the heavier services VM the apt dist-upgrade pushed first-boot past
# the multipass provider's launch timeout (an orphaned VM). The base 24.04 image is recent enough
# for a lab; kept symmetric across both VMs.
package_upgrade: false

# Time sync — pin every VM to UTC and keep the clock disciplined via systemd-timesyncd.
# Declared here (not left to the image default) so cert notBefore/notAfter align cluster-wide.
timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - tar
  - vim
  - htop
  - jq

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /opt/pki/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, ca_compose)}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}

  # Generic exporter installer (copied from the centralized_logging cluster).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"
%{ if log_shipping_target != "" ~}

  # Cross-cluster log shipping — syslog-ng client drop-in (shared snippet) shipping journald +
  # syslog-ng internal() to the centralized_logging collector. See specs/cross-cluster.md.
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, syslog_client_conf)}
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if internal_ca_cert != "" ~}

  # Fleet-wide trust — the internal root CA, installed into the OS trust store by a runcmd. See specs/internal-ca.md.
  - path: /usr/local/share/ca-certificates/internal-root-ca.crt
    permissions: '0644'
    content: |
      ${indent(6, internal_ca_cert)}
%{ endif ~}
%{ if pin_ca ~}

  # Persisted CA material (Phase 0) — pinned over step-ca's self-generated pair by a runcmd after
  # the stack is up, so the root survives `just recreate`. The intermediate key is encrypted with
  # the CA password. See specs/internal-ca.md.
  - path: /opt/pki/pinned/root_ca.crt
    permissions: '0644'
    content: |
      ${indent(6, root_ca_cert)}
  - path: /opt/pki/pinned/intermediate_ca.crt
    permissions: '0644'
    content: |
      ${indent(6, intermediate_ca_cert)}
  - path: /opt/pki/pinned/intermediate_ca_key
    permissions: '0600'
    content: |
      ${indent(6, intermediate_ca_key)}
%{ endif ~}
%{ if openobserve_endpoint != "" ~}

  # Cross-cluster OTLP push — otelcol-contrib agent (shared snippet) shipping host logs to
  # centralized_monitoring's OpenObserve. See specs/cross-cluster.md.
  - path: /etc/otelcol-contrib/config.yaml
    permissions: '0644'
    content: |
      ${indent(6, otel_agent_conf)}
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter config: curated groups + a bounded {{.Comm}} catch-all (empty groups
  # pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: step-ca
          exe: [ step-ca ]
        - name: container-runtime
          exe: [ dockerd, containerd, containerd-shim-runc-v2, runc ]
        - name: proxy-auth
          exe: [ traefik, authelia, vaultwarden ]
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}

runcmd:
  # Enforce UTC late: Multipass injects the host timezone during first boot and can beat the
  # declarative `timezone:` key above. runcmd runs after the config modules, so it wins. See specs/ntp.md.
  - timedatectl set-timezone Etc/UTC
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
%{ endif ~}
%{ if internal_ca_cert != "" ~}
  # Fleet-wide trust — install the internal root CA into the OS trust store. See specs/internal-ca.md.
  - update-ca-certificates
%{ endif ~}
  # step-ca needs its own IP in the cert SAN, but tofu can't self-reference this VM's IP. Compute it
  # at boot and hand it to docker compose via /opt/pki/.env ($${SELF_IP} in the CA compose).
  - |
    SELF_IP=$(ip -4 route get 1.1.1.1 | awk '{print $7; exit}')
    echo "SELF_IP=$SELF_IP" > /opt/pki/.env
  # Docker + step-ca stack
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl restart docker
  - docker compose -f /opt/pki/compose.yaml up -d
%{ if pin_ca ~}
  # Persisted-root pinning (Phase 0): after step-ca self-inits (creating its provisioners +
  # password), swap in the pinned root + intermediate so leaves chain to a STABLE root that
  # survives recreate. Provisioners (admin JWK, acme) are untouched — only the signing identity is
  # replaced. Idempotent: re-running copies the same files. See specs/internal-ca.md.
  - |
    for i in $(seq 1 60); do
      docker exec step-ca test -f /home/step/certs/root_ca.crt && break
      echo "waiting for step-ca init ($i)"; sleep 2
    done
    # The `step` user inside smallstep/step-ca is uid 1000, and `docker cp` preserves the SOURCE
    # numeric owner. /opt/pki/pinned/* are root-owned (write_files), so chown them to 1000 on the
    # host FIRST — otherwise the copied intermediate_ca_key lands root-owned and step-ca (non-root)
    # crash-loops with `permission denied` reading it. A post-cp `docker exec chown` can't be relied
    # on: it defaults to the non-root step user (can't chown root's file), and can't attach at all
    # once the container is already restarting. See specs/pki-and-dns.md.
    chown 1000:1000 /opt/pki/pinned/root_ca.crt /opt/pki/pinned/intermediate_ca.crt /opt/pki/pinned/intermediate_ca_key
    docker cp /opt/pki/pinned/root_ca.crt         step-ca:/home/step/certs/root_ca.crt
    docker cp /opt/pki/pinned/intermediate_ca.crt step-ca:/home/step/certs/intermediate_ca.crt
    docker cp /opt/pki/pinned/intermediate_ca_key step-ca:/home/step/secrets/intermediate_ca_key
    docker exec -u 0 step-ca chown -R step:step /home/step/certs /home/step/secrets || true
    docker restart step-ca
%{ endif ~}
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ if enable_node_exporter ~}
  # node_exporter — OS host metrics (:9100), parity with the other clusters' metrics tests.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter
%{ endif ~}
%{ if log_shipping_target != "" ~}
  # Cross-cluster syslog-ng shipper — install, ensure the drop-in is @included, restart.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y syslog-ng
  - mkdir -p /var/lib/syslog-ng
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}
%{ if openobserve_endpoint != "" ~}
  # Cross-cluster OTLP agent — install the upstream otelcol-contrib .deb (arch-aware), then run
  # our rendered config. The .deb ships a systemd unit reading /etc/otelcol-contrib/config.yaml.
  - mkdir -p /var/lib/otelcol-contrib/storage
  - |
    OTEL_VER=0.109.0
    arch="$(dpkg --print-architecture)"
    curl -sSLf "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$${OTEL_VER}/otelcol-contrib_$${OTEL_VER}_linux_$${arch}.deb" -o /tmp/otelcol.deb
    DEBIAN_FRONTEND=noninteractive dpkg --force-confdef --force-confold -i /tmp/otelcol.deb || DEBIAN_FRONTEND=noninteractive apt-get install -f -y
  # The .deb's unit runs as otelcol-contrib:otelcol-contrib, not root — the dir above was created
  # before that user existed, so it must be chowned after install or the collector crash-loops on
  # "permission denied" opening its file_storage extension.
  - chown -R otelcol-contrib:otelcol-contrib /var/lib/otelcol-contrib/storage
  # /var/log/syslog is root:adm 0640 — the otelcol-contrib user must join `adm` or its filelog/host
  # receiver silently fails every poll with "permission denied" (unit stays "active", logs never ship).
  - usermod -aG adm otelcol-contrib
  - systemctl enable otelcol-contrib
  - systemctl restart otelcol-contrib
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|docker|containerd|node_exporter|systemd_exporter|process-exporter|pki-cert-renew)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}

final_message: "step-ca ready — ACME directory at https://ca.${domain}:9000/acme/acme/directory"
