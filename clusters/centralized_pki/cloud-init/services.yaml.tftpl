#cloud-config
# Services VM — Traefik (TLS termination) in front of Authelia (forward-auth SSO) and Vaultwarden,
# via Docker Compose. In the default mode a boot-time script issues Traefik's cert directly from
# step-ca's JWK provisioner (password auth, no ACME challenge — the DNS-less lab can't do reachback)
# and a timer renews it; Traefik's file provider watches the cert dir. See specs/centralized_pki.md.
package_update: true
# No full package_upgrade: the apt dist-upgrade + Docker install + 4 image pulls pushed first-boot
# past the multipass provider's launch timeout (an orphaned VM). The base 24.04 image is recent
# enough for a lab.
package_upgrade: false

timezone: Etc/UTC
ntp:
  enabled: true
  ntp_client: systemd-timesyncd

packages:
  - curl
  - tar
  - vim
  - htop
  - jq
  - ca-certificates

ssh_authorized_keys:
  - ${ssh_pubkey}

write_files:
  - path: /etc/docker/daemon.json
    permissions: '0644'
    content: |
      {
        "log-driver": "journald"
      }

  # Generic exporter installer (copied from the centralized_logging cluster).
  - path: /usr/local/sbin/install-exporter.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      name="$1"; url="$2"; bin="$3"; shift 3; args="$*"
      arch="$(dpkg --print-architecture 2>/dev/null || uname -m)"
      case "$arch" in aarch64) arch=arm64 ;; x86_64) arch=amd64 ;; esac
      url="$${url//\{ARCH\}/$arch}"
      tmp="$(mktemp -d)"
      curl -sSLf "$url" -o "$tmp/dl"
      if tar -tzf "$tmp/dl" >/dev/null 2>&1; then
        tar -xzf "$tmp/dl" -C "$tmp"
        found="$(find "$tmp" -type f -name "$bin" | head -n1)"
      else
        found="$tmp/dl"
      fi
      install -m0755 "$found" "/usr/local/bin/$name"
      cat >/etc/systemd/system/$name.service <<UNIT
      [Unit]
      Description=$name
      After=network-online.target
      Wants=network-online.target
      [Service]
      ExecStart=/usr/local/bin/$name $args
      Restart=always
      RestartSec=5
      [Install]
      WantedBy=multi-user.target
      UNIT
      systemctl daemon-reload
      systemctl enable --now "$name"

  - path: /opt/stack/compose.yaml
    permissions: '0644'
    content: |
      ${indent(6, compose_conf)}
%{ if enable_docker_tools ~}

  # Interactive docker operator TUIs (wharf, oxker, dive) — installed by a runcmd below.
  - path: /usr/local/sbin/install-docker-tools.sh
    permissions: '0755'
    content: |
      ${indent(6, docker_tools_installer)}
%{ endif ~}

  - path: /opt/stack/traefik/traefik.yaml
    permissions: '0644'
    content: |
      ${indent(6, traefik_static)}

  - path: /opt/stack/traefik/dynamic.yaml
    permissions: '0644'
    content: |
      ${indent(6, traefik_dynamic)}

  - path: /opt/stack/authelia/configuration.yml
    permissions: '0644'
    content: |
      ${indent(6, authelia_conf)}

  - path: /opt/stack/authelia/users_database.yml
    permissions: '0644'
    content: |
      ${indent(6, authelia_users)}
%{ if !enable_letsencrypt_staging ~}

  # step-ca JWK provisioner password (same as the CA key password). |- strips the trailing newline.
  - path: /opt/stack/secrets/provisioner_password
    permissions: '0600'
    content: |-
      ${stepca_ca_password}

  # Fetch step-ca's root (TOFU bootstrap) and issue Traefik's leaf via the JWK provisioner "admin"
  # — password-authenticated, no ACME challenge, so no inbound reachback is needed. Re-runnable:
  # the renew timer calls it again and Traefik's file-watch reloads the rotated cert.
  - path: /usr/local/sbin/issue-cert.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      CERT_DIR=/opt/stack/traefik/certs
      SECRETS=/opt/stack/secrets
      STEP_IMG=smallstep/step-cli:0.28.2
      mkdir -p "$CERT_DIR"
      # 1. Fetch the root (self-authenticating; -k is step-ca's documented TOFU bootstrap).
      for i in $(seq 1 60); do
        if curl -fsSk ${ca_url}/roots.pem -o "$CERT_DIR/root_ca.crt"; then break; fi
        echo "waiting for step-ca at ${ca_url} ($i)"; sleep 5
      done
      cp "$CERT_DIR/root_ca.crt" /usr/local/share/ca-certificates/step-ca-root.crt
      update-ca-certificates || true
      # 2. Issue the Traefik leaf (SANs auth./warden.<domain>). Retry until the CA is ready.
      for i in $(seq 1 30); do
        # --user 0:0: the step-cli image runs as uid 1000, but the mounted provisioner-password
        # file is root-owned 0600; run as root so it can read it (keeps the secret non-world-readable).
        if docker run --rm --user 0:0 \
             --add-host "ca.${domain}:${ca_ip}" \
             -v "$CERT_DIR:/certs" -v "$SECRETS:/secrets:ro" \
             "$STEP_IMG" \
             step ca certificate services /certs/services.crt /certs/services.key \
               --ca-url ${ca_url} --root /certs/root_ca.crt \
               --provisioner ${jwk_provisioner} --provisioner-password-file /secrets/provisioner_password \
               --san "auth.${domain}" --san "warden.${domain}" --force; then
          break
        fi
        echo "cert issuance retry ($i)"; sleep 5
      done
      chmod 644 "$CERT_DIR/services.crt" || true
      chmod 600 "$CERT_DIR/services.key" || true
      # On renewal, nudge Traefik to reload the rotated cert. No-op on first boot (Traefik not up
      # yet — it starts after this with the cert already present).
      docker restart traefik >/dev/null 2>&1 || true

  - path: /etc/systemd/system/pki-cert-renew.service
    permissions: '0644'
    content: |
      [Unit]
      Description=Reissue the Traefik cert from step-ca
      After=docker.service
      Wants=docker.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/issue-cert.sh

  - path: /etc/systemd/system/pki-cert-renew.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Renew the Traefik cert from step-ca every 12h
      [Timer]
      OnBootSec=12h
      OnUnitActiveSec=12h
      [Install]
      WantedBy=timers.target
%{ endif ~}
%{ if log_shipping_target != "" ~}

  # Cross-cluster log shipping — syslog-ng client drop-in (shared snippet) shipping journald +
  # syslog-ng internal() to the centralized_logging collector. See specs/cross-cluster.md.
  - path: /etc/syslog-ng/conf.d/10-ship.conf
    permissions: '0644'
    content: |
      ${indent(6, syslog_client_conf)}
%{ endif ~}
%{ if dns_server != "" ~}

  # Cross-cluster DNS — resolve through the centralized_dns AdGuard Home hub. See specs/cross-cluster.md.
  - path: /etc/systemd/resolved.conf.d/99-centralized-dns.conf
    permissions: '0644'
    content: |
      ${indent(6, dns_resolved_conf)}
%{ endif ~}
%{ if openobserve_endpoint != "" ~}

  # Cross-cluster OTLP push — otelcol-contrib agent (shared snippet) shipping host logs to
  # centralized_monitoring's OpenObserve. See specs/cross-cluster.md.
  - path: /etc/otelcol-contrib/config.yaml
    permissions: '0644'
    content: |
      ${indent(6, otel_agent_conf)}
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter config: curated groups + a bounded {{.Comm}} catch-all (empty groups
  # pruned at runtime via -remove-empty-groups). exe matches the argv[0] basename.
  - path: /etc/process-exporter/all.yaml
    permissions: '0644'
    content: |
      process_names:
        - name: step-ca
          exe: [ step-ca ]
        - name: container-runtime
          exe: [ dockerd, containerd, containerd-shim-runc-v2, runc ]
        - name: proxy-auth
          exe: [ traefik, authelia, vaultwarden ]
        - name: "{{.Comm}}"
          cmdline:
            - '.+'
%{ endif ~}

runcmd:
  - timedatectl set-timezone Etc/UTC
%{ if dns_server != "" ~}
  # Cross-cluster DNS — point this VM's resolver at the centralized_dns AdGuard Home hub.
  - systemctl restart systemd-resolved
  # Wait until the new resolver actually answers before the docker install/pulls below run —
  # otherwise a boot-time race with the AdGuard hub warming up can leave the docker stack
  # permanently empty (SERVFAIL on the registry, no retry). Mirrors centralized_logging's
  # docker-client.yaml.tftpl wait.
  - |
    for i in $(seq 1 30); do
      getent hosts registry-1.docker.io >/dev/null 2>&1 && break
      sleep 2
    done
%{ endif ~}
  - mkdir -p /opt/stack/traefik/certs /opt/stack/traefik/acme /opt/stack/secrets
  # Resolve ca.<domain> to the CA's IP on the host (a convenience for manual `step`/curl use).
  - grep -q "ca.${domain}" /etc/hosts || echo "${ca_ip} ca.${domain}" >> /etc/hosts
  # Docker first (the cert issuance uses `docker run smallstep/step-cli`).
  - curl -fsSL https://get.docker.com | sh
  - systemctl enable docker
  - systemctl restart docker
%{ if !enable_letsencrypt_staging ~}
  # Issue Traefik's cert from step-ca BEFORE the stack starts, then arm the renew timer.
  - /usr/local/sbin/issue-cert.sh
  - systemctl daemon-reload
  - systemctl enable --now pki-cert-renew.timer
%{ endif ~}
  - docker compose -f /opt/stack/compose.yaml up -d
%{ if enable_docker_tools ~}
  # Interactive docker operator TUIs (wharf/oxker/dive); best-effort so a download blip can't
  # break boot. Idempotent — re-run with `sudo /usr/local/sbin/install-docker-tools.sh`.
  - /usr/local/sbin/install-docker-tools.sh || true
%{ endif ~}
%{ if enable_node_exporter ~}
  # node_exporter — OS host metrics (:9100), parity with the other clusters' metrics tests.
  - /usr/local/sbin/install-exporter.sh node_exporter https://github.com/prometheus/node_exporter/releases/download/v1.8.2/node_exporter-1.8.2.linux-{ARCH}.tar.gz node_exporter
%{ endif ~}
%{ if log_shipping_target != "" ~}
  # Cross-cluster syslog-ng shipper — install, ensure the drop-in is @included, restart.
  - DEBIAN_FRONTEND=noninteractive apt-get install -y syslog-ng
  - mkdir -p /var/lib/syslog-ng
  - grep -q 'conf.d/\*.conf' /etc/syslog-ng/syslog-ng.conf || echo '@include "/etc/syslog-ng/conf.d/*.conf"' >> /etc/syslog-ng/syslog-ng.conf
  - systemctl enable syslog-ng
  - systemctl restart syslog-ng
%{ endif ~}
%{ if openobserve_endpoint != "" ~}
  # Cross-cluster OTLP agent — install the upstream otelcol-contrib .deb (arch-aware), then run
  # our rendered config. The .deb ships a systemd unit reading /etc/otelcol-contrib/config.yaml.
  - mkdir -p /var/lib/otelcol-contrib/storage
  - |
    OTEL_VER=0.109.0
    arch="$(dpkg --print-architecture)"
    curl -sSLf "https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v$${OTEL_VER}/otelcol-contrib_$${OTEL_VER}_linux_$${arch}.deb" -o /tmp/otelcol.deb
    DEBIAN_FRONTEND=noninteractive dpkg --force-confdef --force-confold -i /tmp/otelcol.deb || DEBIAN_FRONTEND=noninteractive apt-get install -f -y
  # The .deb's unit runs as otelcol-contrib:otelcol-contrib, not root — the dir above was created
  # before that user existed, so it must be chowned after install or the collector crash-loops on
  # "permission denied" opening its file_storage extension.
  - chown -R otelcol-contrib:otelcol-contrib /var/lib/otelcol-contrib/storage
  # /var/log/syslog is root:adm 0640 — the otelcol-contrib user must join `adm` or its filelog/host
  # receiver silently fails every poll with "permission denied" (unit stays "active", logs never ship).
  - usermod -aG adm otelcol-contrib
  - systemctl enable otelcol-contrib
  - systemctl restart otelcol-contrib
%{ endif ~}
%{ if enable_systemd_exporter ~}
  # systemd_exporter — per-unit health/resource metrics (:9558)
  - /usr/local/sbin/install-exporter.sh systemd_exporter https://github.com/prometheus-community/systemd_exporter/releases/download/v0.7.0/systemd_exporter-0.7.0.linux-{ARCH}.tar.gz systemd_exporter --web.listen-address=:9558 --systemd.collector.unit-include='(ssh|docker|containerd|node_exporter|systemd_exporter|process-exporter|pki-cert-renew)[.]service' --systemd.collector.enable-restart-count
%{ endif ~}
%{ if enable_process_exporter ~}
  # process-exporter — per-process metrics (:9256)
  - /usr/local/sbin/install-exporter.sh process-exporter https://github.com/ncabatoff/process-exporter/releases/download/v0.8.7/process-exporter-0.8.7.linux-{ARCH}.tar.gz process-exporter --config.path=/etc/process-exporter/all.yaml -threads=false -gather-smaps=false -remove-empty-groups
%{ endif ~}

final_message: "services ready — Traefik on :80/:443/:8080; auth.${domain} (Authelia) + warden.${domain} (Vaultwarden)"
